		-- chair (barricade prop)
		local chair = P({ Pos = Vector3.new(x + 2, 0.9, -36), Size = Vector3.new(1.4, 1.8, 1.4), Color = Color3.fromRGB(110, 75, 50), Material = Enum.Material.Wood, Name = "Chair" .. num })
		local barPrompt = makePrompt(chair, "Barricade door (+5s)", 0, 9)
		-- ceiling fixture
		local cl = P({ Pos = Vector3.new(x, 9.6, -39.5), Size = Vector3.new(3.4, 0.25, 1.4), Color = Color3.fromRGB(255, 240, 210), Material = Enum.Material.Neon, Name = "RoomLight" .. num })
		local clLight = light(cl, 1.0, 16)
		-- wall art
		P({ Pos = Vector3.new(x, 6.5, -32.75), Size = Vector3.new(2, 2.6, 0.2), Color = Color3.fromRGB(70, 52, 36), CanCollide = false })
		-- door (5 wide gap)
		local door = P({ Pos = Vector3.new(x, 3.5, -32.5), Size = Vector3.new(5, 7, 0.4), Color = Color3.fromRGB(118, 84, 54), Material = Enum.Material.Wood, Name = "Door" .. num })
		label(door, tostring(num), Color3.fromRGB(238, 224, 180), Enum.NormalId.Front)
		P({ Parent = door, Pos = Vector3.new(2, 0, 0.3), Size = Vector3.new(0.22, 0.22, 0.8), Color = Color3.fromRGB(210, 180, 90), Material = Enum.Material.Metal, CanCollide = false })
		local dPrompt = makePrompt(door, "Close", 0, 9)
		Map.Doors[num] = {
			part = door, prompt = dPrompt, room = num,
			closed = door.CFrame, isOpen = true, locked = false, barricaded = false,
			openCF = door.CFrame * CFrame.new(-2.5, 0, 0) * CFrame.Angles(0, math.rad(-100), 0) * CFrame.new(2.5, 0, 0),
			light = cl, lightObj = clLight, lamp = shade,
			knock = nil, breaking = false, chair = chair, barPrompt = barPrompt,
		}
		Map.Rooms[num] = { num = num, state = "clean", occupant = nil }
		Map.RoomLights[num] = cl
		barPrompt.Enabled = false
		door.CFrame = Map.Doors[num].openCF
	end

	-- ============ NEON MOTEL SIGN ============
	P({ Pos = Vector3.new(-48, 8, 66), Size = Vector3.new(2, 16, 2), Color = Color3.fromRGB(56, 56, 60), Material = Enum.Material.Metal, Name = "SignPole" })
	P({ Pos = Vector3.new(-40, 5, 66), Size = Vector3.new(2, 10, 2), Color = Color3.fromRGB(56, 56, 60), Material = Enum.Material.Metal, Name = "SignPole2" })
	local signBoard = P({ Pos = Vector3.new(-44, 20, 66), Size = Vector3.new(26, 9, 1.2), Color = Color3.fromRGB(24, 20, 24), Name = "SignBoard" })
	local motelText = label(signBoard, "MOTEL", Color3.fromRGB(255, 42, 42))
	local numberBoard = P({ Pos = Vector3.new(-44, 12.5, 66), Size = Vector3.new(9, 6, 1.2), Color = Color3.fromRGB(24, 20, 24), Name = "NumberBoard" })
	local numberText = label(numberBoard, "9", Color3.fromRGB(60, 255, 95))
	-- neon tube border
	for _, def in ipairs({
		{ Vector3.new(-44, 24.8, 66), Vector3.new(27, 0.4, 1.5) },
		{ Vector3.new(-44, 15.2, 66), Vector3.new(27, 0.4, 1.5) },
		{ Vector3.new(-57.7, 20, 66), Vector3.new(0.4, 10, 1.5) },
		{ Vector3.new(-30.3, 20, 66), Vector3.new(0.4, 10, 1.5) },
	}) do
		local tube = P({ Pos = def[1], Size = def[2], Color = Color3.fromRGB(255, 42, 42), Material = Enum.Material.Neon, Name = "SignNeon" .. #Map.SignNeons + 1 })
		table.insert(Map.SignNeons, tube)
	end
	local vacancy = P({ Pos = Vector3.new(-44, 17, 64.6), Size = Vector3.new(11, 2.8, 0.4), Color = Color3.fromRGB(18, 18, 20), Name = "VacancyBoard" })
	local vacancyText = label(vacancy, "VACANCY", Color3.fromRGB(70, 255, 110))
	light(signBoard, 2.5, 55, Color3.fromRGB(255, 60, 60))
	Map.SignParts = { signBoard, numberBoard, vacancy }
	Map.SignTexts = { motel = motelText, number = numberText, vacancy = vacancyText }

	-- STREETLAMPS
	for _, lx in ipairs({ 18, -18 }) do
		P({ Pos = Vector3.new(lx, 7, 74), Size = Vector3.new(0.9, 14, 0.9), Color = Color3.fromRGB(48, 48, 52), Material = Enum.Material.Metal, Name = "LampPost" })
		local head = P({ Pos = Vector3.new(lx + 1.5, 14.2, 74), Size = Vector3.new(3.4, 0.5, 1.8), Color = Color3.fromRGB(255, 235, 180), Material = Enum.Material.Neon, Name = "StreetLamp" })
		light(head, 1.7, 38)
	end

	-- TREES + BUSHES
	for _, t in ipairs({ { -62, 30, 1.2 }, { -66, 54 }, { 60, 28, 1.1 }, { 64, 52, 1.3 }, { -72, 72, 1.4 }, { 72, 72 }, { -54, 8 }, { 54, 6, 1.2 }, { -70, 18 }, { 70, 14, 1.1 }, { -58, 88, 1.3 }, { 58, 88 } }) do
		tree(t[1], t[2], t[3])
	end
	for _, b in ipairs({ { -40, 22 }, { 40, 22 }, { -36, 70 }, { 36, 70 }, { -52, 40 }, { 52, 40 } }) do
		bush(b[1], b[2])
	end

	-- ============ SECURITY CAMERAS ============
	local camDefs = {
		{ pos = Vector3.new(0, 11.5, 15), look = Vector3.new(0, 2.5, 22) },
		{ pos = Vector3.new(0, 17, 52), look = Vector3.new(0, 1.5, 36) },
		{ pos = Vector3.new(29, 9, -26), look = Vector3.new(-30, 2, -26) },
		{ pos = Vector3.new(-29, 11.5, -14), look = Vector3.new(12, 2.5, -2) },
	}
	for i, def in ipairs(camDefs) do
		local cam = P({ Pos = def.pos, Size = Vector3.new(1, 1, 1), Transparency = 1, CanCollide = false, Name = "Cam" .. i })
		cam.CFrame = CFrame.lookAt(def.pos, def.look)
		P({ Pos = def.pos + Vector3.new(0, 0.9, 0), Size = Vector3.new(0.8, 0.8, 1.6), Color = Color3.fromRGB(38, 38, 42), Material = Enum.Material.Metal, Name = "CamBody" .. i })
		Map.Cameras[i] = { part = cam, name = "CAM 0" .. i }
	end

	-- RAIN + DUST EMITTER HOLDERS
	local rainPart = P({ Pos = Vector3.new(0, 60, 30), Size = Vector3.new(110, 1, 110), Transparency = 1, CanCollide = false, Name = "RainEmitter" })
	Map.RainPart = rainPart
	local dustPart = P({ Pos = Vector3.new(0, 10, -2), Size = Vector3.new(24, 1, 24), Transparency = 1, CanCollide = false, Name = "DustEmitter" })
	Map.DustPart = dustPart

	-- SPAWN
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Anchored = true
	spawnLoc.Size = Vector3.new(10, 0.4, 10)
	spawnLoc.CFrame = CFrame.new(0, 0.25, 52)
	spawnLoc.Color = Color3.fromRGB(66, 66, 70)
	spawnLoc.Material = Enum.Material.Concrete
	spawnLoc.Neutral = true
	spawnLoc.Name = "SpawnLocation"
	spawnLoc.Parent = map

	return Map
end

return MapBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">SanityServer</string><ProtectedString name="Source">-- SanityServer: per-player sanity, coffee, warmer (20 min real-time), hallucination flag.
local Players = game:GetService("Players")

local SanityServer = {}
local ctx, Config, Remotes, State, Map
local values = {}

function SanityServer.Init(c)
	ctx = c
	Config = c.Config
	Remotes = c.Remotes
	State = c.State
	Map = c.Map

	Map.CoffeeBuyPrompt.Triggered:Connect(function(player)
		local price = SanityServer.GetCoffeePrice()
		if State.money &lt; price and not State.toggles.infiniteMoney then
			ctx.notify(player, "Not enough money for coffee ($" .. price .. ").", "bad")
			return
		end
		if not State.toggles.infiniteMoney then
			State.money = State.money - price
		end
		SanityServer.Recover(player, Config.CoffeeSanity)
		ctx.notify(player, "Coffee bought: +" .. Config.CoffeeSanity .. " sanity.", "good")
		ctx.Controls.log("Coffee purchased by " .. player.Name .. " (-$" .. price .. ")")
		ctx.sendState()
	end)

	Map.WarmerDrinkPrompt.Triggered:Connect(function(player)
		if not State.toggles.instantCoffee and workspace:GetServerTimeNow() &lt; State.warmerReadyAt then return end
		SanityServer.Recover(player, Config.WarmerSanity)
		ctx.notify(player, "Fresh pot: +" .. Config.WarmerSanity .. " sanity. The warmer starts a new pot.", "good")
		State.warmerReadyAt = workspace:GetServerTimeNow() + Config.WarmerMinutes * 60
		Map.WarmerDrinkPrompt.Enabled = false
		ctx.sendState()
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local ready = State.toggles.instantCoffee or workspace:GetServerTimeNow() &gt;= State.warmerReadyAt
			if ready and not Map.WarmerDrinkPrompt.Enabled then
				Map.WarmerDrinkPrompt.Enabled = true
				ctx.VFX.Play("bell", Map.Warmer, 1, 1.3)
				ctx.notify(nil, "COFFEE READY — free pot at the warmer!", "good")
				ctx.sendState()
			elseif not ready and Map.WarmerDrinkPrompt.Enabled and not State.toggles.instantCoffee then
				Map.WarmerDrinkPrompt.Enabled = false
			end
		end
	end)
end

function SanityServer.GetCoffeePrice()
	return State.coffeePrice or Config.CoffeePrice
end

function SanityServer.AddPlayer(player)
	values[player] = 100
	Remotes.Sanity:FireClient(player, 100)
end

function SanityServer.RemovePlayer(player)
	values[player] = nil
end

local function push(player)
	local v = values[player] or 100
	Remotes.Sanity:FireClient(player, v)
	Remotes.Hallucinate:FireClient(player, v &lt;= 0)
end

function SanityServer.Get(player)
	return values[player] or 100
end

function SanityServer.Drain(player, amount, reason)
	if State.toggles.noSanityDrain and amount &gt; 0 then return end
	if not values[player] then values[player] = 100 end
	values[player] = math.clamp(values[player] - amount, 0, 100)
	push(player)
end

function SanityServer.Recover(player, amount)
	if not values[player] then values[player] = 100 end
	values[player] = math.clamp(values[player] + amount, 0, 100)
	push(player)
end

function SanityServer.Set(player, v)
	values[player] = math.clamp(v, 0, 100)
	push(player)
end

function SanityServer.RefillAll()
	for _, pl in ipairs(Players:GetPlayers()) do
		SanityServer.Set(pl, 100)
	end
end

function SanityServer.GetValues()
	return values
end

return SanityServer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">ShopServer</string><ProtectedString name="Source">-- ShopServer: dawn shop — buy Desk 2 and Desk 3 with in-game money only.
local Players = game:GetService("Players")

local ShopServer = {}
local ctx, Config, Remotes, State, Map

function ShopServer.Init(c)
	ctx = c
	Config = c.Config
	Remotes = c.Remotes
	State = c.State
	Map = c.Map
end

function ShopServer.Handle(player, action, data)
	if action ~= "buyDesk" then return end
	local slot = tonumber(data)
	if slot ~= 2 and slot ~= 3 then return end
	if State.phase ~= "Dawn" and State.phase ~= "Shop" then
		ctx.notify(player, "The shop is only open at dawn.", "bad")
		return
	end
	if slot &lt;= State.desksBought then
		ctx.notify(player, "That desk is already yours.", "info")
		return
	end
	if slot ~= State.desksBought + 1 then
		ctx.notify(player, "Buy the desks in order.", "bad")
		return
	end
	if #Players:GetPlayers() &lt; slot then
		ctx.notify(player, "Needs a friend to sit here.", "bad")
		return
	end
	local price = Config.DeskPrices[slot]
	if State.money &lt; price and not State.toggles.infiniteMoney then
		ctx.notify(player, "Not enough money ($" .. price .. " needed).", "bad")
		return
	end
	if not State.toggles.infiniteMoney then
		State.money = State.money - price
	end
	State.desksBought = slot
	ctx.Controls.setDeskBought(slot, true)
	ctx.notify(nil, "Desk " .. slot .. " installed! Sit there to serve your own guests.", "good")
	ctx.Controls.log("Desk " .. slot .. " purchased for $" .. price)
	ctx.sendState()
end

return ShopServer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">VFXServer</string><ProtectedString name="Source">-- VFXServer: every visual effect and sound in one place.
local VFXServer = {}

local builtins = {
	bell = "rbxasset://sounds/electronicpingshort.wav",
	click = "rbxasset://sounds/button.wav",
	lock = "rbxasset://sounds/snap.mp3",
	static = "rbxasset://sounds/flashbulb.wav",
	breakDoor = "rbxasset://sounds/glassbreak.wav",
	caught = "rbxasset://sounds/uuhhh.mp3",
	whoosh = "rbxasset://sounds/swoosh.wav",
	dawn = "rbxasset://sounds/victory.wav",
	rumble = "rbxasset://sounds/collide.wav",
	drone = "rbxasset://sounds/bass.wav",
	water = "rbxasset://sounds/impact_water.mp3",
}

local Lighting = game:GetService("Lighting")
local rainEmitter, dustEmitter, droneLoop
local signBaseColor = Color3.fromRGB(255, 40, 40)
local flickerRunning = false

function VFXServer.Init(ctx)
	VFXServer.ctx = ctx
	local Map = ctx.Map

	local rain = Instance.new("ParticleEmitter")
	rain.Texture = "rbxassetid://241876428"
	rain.Rate = 260
	rain.Lifetime = NumberRange.new(1.6, 2.2)
	rain.Speed = NumberRange.new(38, 46)
	rain.Acceleration = Vector3.new(2, -12, 4)
	rain.Size = NumberSequence.new(0.35)
	rain.Transparency = NumberSequence.new(0.35)
	rain.Rotation = NumberRange.new(0, 360)
	rain.RotSpeed = NumberRange.new(-40, 40)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Color = ColorSequence.new(Color3.fromRGB(190, 205, 220))
	rain.Parent = Map.RainPart
	rainEmitter = rain

	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	dust.Rate = 6
	dust.Lifetime = NumberRange.new(4, 8)
	dust.Speed = NumberRange.new(0.2, 0.6)
	dust.Size = NumberSequence.new(0.12)
	dust.Transparency = NumberSequence.new(0.75)
	dust.EmissionDirection = Enum.NormalId.Bottom
	dust.Color = ColorSequence.new(Color3.fromRGB(255, 240, 210))
	dust.Parent = Map.DustPart
	dustEmitter = dust

	droneLoop = Instance.new("Sound")
	droneLoop.SoundId = builtins.drone
	droneLoop.Looped = true
	droneLoop.Volume = 0.15
	droneLoop.Pitch = 0.45
	droneLoop.Parent = workspace
	droneLoop:Play()

	task.spawn(function()
		while true do
			task.wait(math.random(25, 70))
			VFXServer.Thunder()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(math.random(7, 18))
			if not flickerRunning and ctx.State.phase == "Night" then
				VFXServer.FlickerRandom()
			end
		end
	end)
end

function VFXServer.Play(name, parent, volume, pitch, looped)
	local s = Instance.new("Sound")
	s.SoundId = builtins[name] or builtins.click
	s.Volume = volume or 0.8
	s.Pitch = pitch or 1
	s.Looped = looped or false
	s.Parent = parent or workspace
	s:Play()
	if not looped then
		game:GetService("Debris"):AddItem(s, 6)
	end
	return s
end

function VFXServer.Thunder()
	VFXServer.Play("rumble", workspace, 0.5, 0.3)
end

function VFXServer.SetRain(on, intensity)
	if not rainEmitter then return end
	rainEmitter.Enabled = on
	if intensity then rainEmitter.Rate = 260 * intensity end
end

function VFXServer.SetFog(on)
	local atmo = Lighting:FindFirstChild("Atmosphere")
	if atmo then atmo.Density = on and 0.42 or 0.15 end
end

function VFXServer.SetSign(on, color)
	local ctx = VFXServer.ctx
	for _, p in ipairs(ctx.Map.SignNeons) do
		p.Transparency = on and 0 or 1
		if color then p.Color = color end
	end
	if color then
		ctx.Map.SignTexts.motel.TextColor3 = color
	else
		ctx.Map.SignTexts.motel.TextColor3 = signBaseColor
	end
	ctx.Map.SignTexts.number.Visible = on
	ctx.Map.SignBoard.Transparency = on and 0 or 0.4
end

local function setAllLights(on, color)
	local Map = VFXServer.ctx.Map
	for _, l in ipairs(Map.LobbyLights) do
		l.Transparency = on and 0 or 1
		local pl = l:FindFirstChildOfClass("PointLight")
		if pl then pl.Enabled = on if color then pl.Color = color end end
		if color then l.Color = color end
	end
	if Map.CorridorLight then
		Map.CorridorLight.Transparency = on and 0 or 1
		local pl = Map.CorridorLight:FindFirstChildOfClass("PointLight")
		if pl then pl.Enabled = on if color then pl.Color = color end end
		if color then Map.CorridorLight.Color = color end
	end
	for _, door in pairs(Map.Doors) do
		door.light.Transparency = on and 0 or 1
		local pl = door.lightObj
		if pl then pl.Enabled = on if color then pl.Color = color end end
		if color then door.light.Color = color end
	end
end

function VFXServer.SetLights(on)
	setAllLights(on, nil)
end

function VFXServer.FlickerRandom()
	flickerRunning = true
	local Map = VFXServer.ctx.Map
	local pool = {}
	for _, l in ipairs(Map.LobbyLights) do table.insert(pool, l) end
	table.insert(pool, Map.CorridorLight)
	local target = pool[math.random(#pool)]
	for i = 1, 3 do
		target.Transparency = 1
		local pl = target:FindFirstChildOfClass("PointLight")
		if pl then pl.Enabled = false end
		task.wait(0.08)
		target.Transparency = 0
		if pl then pl.Enabled = true end
		task.wait(0.12)
	end
	flickerRunning = false
end

function VFXServer.PowerFlicker(duration)
	flickerRunning = true
	setAllLights(false, nil)
	VFXServer.ctx.Remotes.PowerFlicker:FireAllClients(duration)
	for _, pl in ipairs(game:GetService("Players"):GetPlayers()) do
		VFXServer.ctx.Sanity.Drain(pl, 5, "power flicker")
	end
	task.wait(duration or 10)
	setAllLights(true, nil)
	flickerRunning = false
end

function VFXServer.Lockdown(on)
	setAllLights(on, Color3.fromRGB(255, 30, 30))
	local atmo = Lighting:FindFirstChild("Atmosphere")
	if atmo then
		if on then
			atmo.Color = Color3.fromRGB(120, 10, 10)
			atmo.Haze = 3
		else
			atmo.Color = Color3.fromRGB(120, 124, 134)
			atmo.Haze = 2
		end
	end
end

function VFXServer.DawnLight()
	Lighting.OutdoorAmbient = Color3.fromRGB(190, 150, 110)
	Lighting.Ambient = Color3.fromRGB(120, 100, 90)
	Lighting.Brightness = 2.4
	VFXServer.Play("dawn", workspace, 0.7)
end

function VFXServer.NightLight()
	Lighting.OutdoorAmbient = Color3.fromRGB(18, 22, 34)
	Lighting.Ambient = Color3.fromRGB(8, 8, 12)
	Lighting.Brightness = 0.6
end

function VFXServer.Shake(intensity)
	VFXServer.ctx.Remotes.Shake:FireAllClients(intensity or 1)
end

return VFXServer
</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX22"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX21"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX13"><Properties><string name="Name">AdminClient</string><ProtectedString name="Source">-- AdminClient: tabbed admin panel. ONLY built for UserId 6157267885 (erdl18).
-- The server re-checks the UserId on every action; this GUI simply does not
-- exist for anyone else.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local ADMIN_ID = 6157267885
if player.UserId ~= ADMIN_ID then return end

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("NSM_Admin")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "NSM_Admin"
gui.ResetOnSpawn = false
gui.Parent = pg

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function fire(action, data)
	remotes.Admin:FireServer(action, data)
end

local adminBtn = mk("TextButton", { Size = UDim2.new(0, 110, 0, 42), Position = UDim2.new(1, -118, 0, 6), BackgroundColor3 = Color3.fromRGB(120, 20, 20), TextColor3 = Color3.fromRGB(255, 220, 220), TextScaled = true, Font = Enum.Font.Arcade, Text = "ADMIN", ZIndex = 20 }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, adminBtn)

local panel = mk("Frame", { Size = UDim2.new(0.94, 0, 0.85, 0), Position = UDim2.new(0.03, 0, 0.075, 0), BackgroundColor3 = Color3.fromRGB(14, 14, 18), BackgroundTransparency = 0.05, Visible = false, ZIndex = 21 }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 10) }, panel)
mk("UIStroke", { Color = Color3.fromRGB(120, 20, 20), Thickness = 2 }, panel)

local tabs = { "GAME", "GUESTS", "ECONOMY", "DESKS", "HUNT", "MAP", "PLAYERS", "TOGGLES", "LOG" }
local tabFrame = mk("Frame", { Size = UDim2.new(0, 110, 1, -10), Position = UDim2.new(0, 5, 0, 5), BackgroundTransparency = 1, ZIndex = 22 }, panel)
mk("UIListLayout", { Padding = UDim.new(0, 4) }, tabFrame)
local content = mk("Frame", { Size = UDim2.new(1, -130, 1, -50), Position = UDim2.new(0, 120, 0, 40), BackgroundTransparency = 1, ZIndex = 22 }, panel)
local titleBar = mk("TextLabel", { Size = UDim2.new(1, -130, 0, 32), Position = UDim2.new(0, 120, 0, 4), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 90, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "ADMIN PANEL", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 22 }, panel)
local closeBtn = mk("TextButton", { Size = UDim2.new(0, 60, 0, 28), Position = UDim2.new(1, -66, 0, 4), BackgroundColor3 = Color3.fromRGB(120, 20, 20), TextColor3 = Color3.fromRGB(255, 230, 230), TextScaled = true, Font = Enum.Font.Arcade, Text = "X", ZIndex = 23 }, panel)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, closeBtn)

local pages = {}
local function page(name)
	local f = mk("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarThickness = 6, Visible = false, ZIndex = 22 }, content)
	mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, f)
	pages[name] = f
	return f
end
for _, name in ipairs(tabs) do
	page(name)
	local b = mk("TextButton", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Color3.fromRGB(40, 40, 52), TextColor3 = Color3.fromRGB(230, 230, 240), TextScaled = true, Font = Enum.Font.Arcade, Text = name, ZIndex = 23 }, tabFrame)
	mk("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	b.MouseButton1Click:Connect(function()
		for n, f in pairs(pages) do f.Visible = (n == name) end
		titleBar.Text = "ADMIN — " .. name
		if name == "LOG" then fire("getLog") end
		if name == "PLAYERS" then fire("listPlayers") end
	end)
end

local function row(parent, order)
	local f = mk("Frame", { LayoutOrder = order, Size = UDim2.new(1, -8, 0, 40), BackgroundColor3 = Color3.fromRGB(24, 24, 32), ZIndex = 22 }, parent)
	mk("UICorner", { CornerRadius = UDim.new(0, 6) }, f)
	return f
end

local order = 0
local function addBtn(parent, text, action, data)
	order = order + 1
	local f = row(parent, order)
	local b = mk("TextButton", { Size = UDim2.new(1, -10, 1, -8), Position = UDim2.new(0, 5, 0, 4), BackgroundColor3 = Color3.fromRGB(70, 30, 30), TextColor3 = Color3.fromRGB(255, 220, 220), TextScaled = true, Font = Enum.Font.Arcade, Text = text, ZIndex = 23 }, f)
	mk("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	b.MouseButton1Click:Connect(function()
		fire(action, data)
	end)
	return b, f
end

local function addValueBtn(parent, text, action, buildData, default)
	order = order + 1
	local f = row(parent, order)
	f.Size = UDim2.new(1, -8, 0, 44)
	local box = mk("TextBox", { Size = UDim2.new(0, 110, 1, -10), Position = UDim2.new(0, 5, 0, 5), BackgroundColor3 = Color3.fromRGB(40, 40, 52), TextColor3 = Color3.fromRGB(255, 255, 255), TextScaled = true, Font = Enum.Font.Code, Text = tostring(default), ZIndex = 23 }, f)
	mk("UICorner", { CornerRadius = UDim.new(0, 6) }, box)
	local b = mk("TextButton", { Size = UDim2.new(1, -135, 1, -10), Position = UDim2.new(0, 125, 0, 5), BackgroundColor3 = Color3.fromRGB(30, 70, 110), TextColor3 = Color3.fromRGB(220, 235, 255), TextScaled = true, Font = Enum.Font.Arcade, Text = text, ZIndex = 23 }, f)
	mk("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	b.MouseButton1Click:Connect(function()
		fire(action, buildData(box.Text))
	end)
	return box
end

-- GAME
local g = pages.GAME
addBtn(g, "START GAME", "start")
addBtn(g, "PAUSE / RESUME GUESTS", "pause", true)
addBtn(g, "END GAME (back to lobby)", "endGame")
addValueBtn(g, "SET NIGHT (1-5)", "setNight", function(v) return tonumber(v) end, 1)
addBtn(g, "SKIP TO NEXT NIGHT", "nextNight")
addBtn(g, "RESTART CURRENT NIGHT", "restartNight")
addBtn(g, "SKIP TO DAWN", "skipDawn")
addBtn(g, "WIN NOW", "win")
addBtn(g, "LOSE NOW", "lose")
addBtn(g, "RESET EVERYTHING (fresh Night 1)", "reset")

-- GUESTS
local gu = pages.GUESTS
addBtn(gu, "SPAWN A GUEST NOW", "spawnGuest")
addBtn(gu, "FORCE NEXT: HUMAN", "forceHuman")
addBtn(gu, "FORCE NEXT: MONSTER", "forceMonster")
addBtn(gu, "CLEAR FORCE", "clearForce")
addBtn(gu, "REMOVE CURRENT GUEST(S)", "removeCurrent")
addBtn(gu, "CLEAR WHOLE QUEUE", "clearQueue")
addValueBtn(gu, "SET GUESTS PER NIGHT", "setQuotaGuests", function(v) return tonumber(v) end, 5)
addValueBtn(gu, "SET MONSTERS PER NIGHT", "setQuotaMonsters", function(v) return tonumber(v) end, 1)

-- ECONOMY
local e = pages.ECONOMY
addValueBtn(e, "SET TEAM MONEY", "setMoney", function(v) return tonumber(v) end, 100)
addValueBtn(e, "GIVE MONEY", "giveMoney", function(v) return tonumber(v) end, 50)
addValueBtn(e, "SET REPUTATION", "setRep", function(v) return tonumber(v) end, 0)
addValueBtn(e, "SET MY SANITY", "setSanity", function(v) return { player = player.Name, value = tonumber(v) } end, 100)
addBtn(e, "REFILL EVERYONE'S SANITY", "refillSanity")
addValueBtn(e, "SET COFFEE PRICE", "setCoffeePrice", function(v) return tonumber(v) end, 5)

-- DESKS
local d = pages.DESKS
addBtn(d, "GIVE DESK 2 FREE", "giveDesk", 2)
addBtn(d, "GIVE DESK 3 FREE", "giveDesk", 3)
addBtn(d, "REMOVE LAST DESK", "removeDesk", 3)
addBtn(d, "UNLOCK ALL DESKS", "unlockAllDesks")
addValueBtn(d, "SET DESK 2 PRICE", "setDeskPrice", function(v) return { slot = 2, price = tonumber(v) } end, 150)
addValueBtn(d, "SET DESK 3 PRICE", "setDeskPrice", function(v) return { slot = 3, price = tonumber(v) } end, 300)

-- HUNT
local h = pages.HUNT
addBtn(h, "START HUNT NOW", "startHunt")
addBtn(h, "STOP HUNT", "stopHunt")
addBtn(h, "SPAWN A MONSTER NOW", "spawnMonster")
addBtn(h, "REMOVE ALL MONSTERS", "removeMonsters")
addValueBtn(h, "SET HUNT TIMER (seconds)", "setHuntTimer", function(v) return tonumber(v) end, 60)
addValueBtn(h, "SET MONSTER WALK SPEED", "setMonsterSpeed", function(v) return tonumber(v) end, 16)

-- MAP / WEATHER
local m = pages.MAP
addBtn(m, "RAIN ON", "rainOn")
addBtn(m, "RAIN OFF", "rainOff")
addValueBtn(m, "RAIN INTENSITY (0.1-3)", "rainIntensity", function(v) return tonumber(v) end, 1)
addBtn(m, "FOG ON", "fogOn")
addBtn(m, "FOG OFF", "fogOff")
addBtn(m, "SIGN ON", "signOn")
addBtn(m, "SIGN OFF", "signOff")
addValueBtn(m, "SIGN COLOR (R,G,B 0-255)", "signColor", function(v)
	local parts = string.split(v, ",")
	return Color3.fromRGB(tonumber(parts[1]) or 255, tonumber(parts[2]) or 40, tonumber(parts[3]) or 40)
end, "255,40,40")
addBtn(m, "ALL LIGHTS ON", "lightsOn")
addBtn(m, "ALL LIGHTS OFF", "lightsOff")
addBtn(m, "TRIGGER POWER FLICKER NOW", "flicker")
addBtn(m, "LOCK ALL ROOM DOORS", "lockDoors")
addBtn(m, "UNLOCK ALL ROOM DOORS", "unlockDoors")
addBtn(m, "OPEN ALL DOORS", "openDoors")
addBtn(m, "CLOSE ALL DOORS", "closeDoors")

-- PLAYERS
local p = pages.PLAYERS
local playersList = mk("TextLabel", { LayoutOrder = 1, Size = UDim2.new(1, -8, 0, 120), BackgroundColor3 = Color3.fromRGB(24, 24, 32), TextColor3 = Color3.fromRGB(200, 200, 215), TextSize = 16, Font = Enum.Font.Code, Text = "Press PLAYERS tab to refresh...", TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 22 }, p)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, playersList)
mk("TextBox", { LayoutOrder = 2, Size = UDim2.new(1, -8, 0, 34), BackgroundColor3 = Color3.fromRGB(40, 40, 52), TextColor3 = Color3.fromRGB(255, 255, 255), TextScaled = true, Font = Enum.Font.Code, Text = player.Name, PlaceholderText = "player name", Name = "TargetBox", ZIndex = 22 }, p)
local targetBox = p:FindFirstChild("TargetBox")
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, targetBox)
addBtn(p, "TELEPORT PLAYER -&gt; LOBBY", "teleport", { where = "lobby", player = "TARGET" })
addBtn(p, "TELEPORT PLAYER -&gt; SECURITY ROOM", "teleport", { where = "security", player = "TARGET" })
addBtn(p, "TELEPORT PLAYER -&gt; ME", "teleport", { where = "me", player = "TARGET" })
addValueBtn(p, "TELEPORT PLAYER -&gt; ROOM (101-106)", "teleportRoom", function(v) return { where = v, player = "TARGET" } end, "101")
addBtn(p, "HEAL / UN-DOWN PLAYER", "heal", "TARGET")
addBtn(p, "KICK PLAYER", "kick", "TARGET")

-- TOGGLES
local tg = pages.TOGGLES
addBtn(tg, "GOD MODE (cannot be caught)", "toggle", "god")
addBtn(tg, "INFINITE MONEY", "toggle", "infiniteMoney")
addBtn(tg, "NO SANITY DRAIN", "toggle", "noSanityDrain")
addBtn(tg, "INSTANT COFFEE WARMER", "toggle", "instantCoffee")
addBtn(tg, "FREEZE GUESTS (stop arrivals)", "toggle", "freeze")

-- LOG
local lg = pages.LOG
local logBox = mk("TextLabel", { LayoutOrder = 1, Size = UDim2.new(1, -8, 0, 900), BackgroundColor3 = Color3.fromRGB(10, 10, 14), TextColor3 = Color3.fromRGB(140, 255, 160), TextSize = 14, Font = Enum.Font.Code, Text = "", TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 22 }, lg)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, logBox)

remotes.AdminData.OnClientEvent:Connect(function(payload)
	if payload.kind == "log" then
		local txt = ""
		for _, line in ipairs(payload.entries) do
			txt = txt .. line .. "\n"
		end
		logBox.Text = txt
	elseif payload.kind == "players" then
		local txt = ""
		for _, pl in ipairs(payload.list) do
			txt = txt .. pl.name .. "  ($" .. pl.money .. ", rep " .. pl.rep .. ", sanity " .. pl.sanity .. ")\n"
		end
		playersList.Text = txt
	elseif payload.kind == "open" then
		panel.Visible = true
	end
end)

adminBtn.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
end)
closeBtn.MouseButton1Click:Connect(function()
	panel.Visible = false
end)

-- fill "TARGET" with the name typed in the PLAYERS tab
local oldFire = fire
fire = function(action, data)
	if type(data) == "table" and data.player == "TARGET" then
		data.player = targetBox.Text
	elseif data == "TARGET" then
		data = targetBox.Text
	end
	oldFire(action, data)
end
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX14"><Properties><string name="Name">CamerasClient</string><ProtectedString name="Source">-- CamerasClient v2: 4 security feeds by moving the camera to camera parts.
-- Clean, watchable feeds: subtle scanlines + rare static bursts (full static
-- only during power flickers), big touch-friendly cam buttons and EXIT.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("NSM_Cams")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "NSM_Cams"
gui.ResetOnSpawn = false
gui.Parent = pg

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local camApps = {}
local guestModels = {}
local viewing = nil
local baseFOV = 70
local camFolder = workspace:WaitForChild("Map", 30)

local openBtn = mk("TextButton", { Size = UDim2.new(0, 140, 0, 44), Position = UDim2.new(0, 8, 0.5, 4), BackgroundColor3 = Color3.fromRGB(20, 50, 30), TextColor3 = Color3.fromRGB(120, 255, 140), TextScaled = true, Font = Enum.Font.Arcade, Text = "CAMERAS" }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, openBtn)

local overlay = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.55, Visible = false, ZIndex = 5 }, gui)
local static = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(210, 210, 210), BackgroundTransparency = 1, Visible = true, ZIndex = 6, BorderSizePixel = 0 }, overlay)
local scanline = mk("Frame", { Size = UDim2.new(1, 0, 0.05, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.82, Visible = true, ZIndex = 6, BorderSizePixel = 0 }, overlay)
local camLabel = mk("TextLabel", { Size = UDim2.new(0, 220, 0, 40), Position = UDim2.new(0, 12, 0, 64), BackgroundColor3 = Color3.fromRGB(10, 10, 12), TextColor3 = Color3.fromRGB(120, 255, 140), TextScaled = true, Font = Enum.Font.Code, Text = "CAM 01", ZIndex = 7 }, overlay)
local recDot = mk("TextLabel", { Size = UDim2.new(0, 70, 0, 34), Position = UDim2.new(1, -80, 0, 64), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 60, 60), TextScaled = true, Font = Enum.Font.Arcade, Text = "REC", ZIndex = 7 }, overlay)

-- CAM BUTTONS: big row across the top (easy to hit with a thumb)
local btnRow = mk("Frame", { Size = UDim2.new(1, -24, 0, 48), Position = UDim2.new(0, 12, 0, 8), BackgroundTransparency = 1, ZIndex = 7 }, overlay)
mk("UIGridLayout", { CellSize = UDim2.new(0.24, -8, 1, 0), CellPadding = UDim2.new(0, 8, 0, 0) }, btnRow)

local camNames = { "CAM 01", "CAM 02", "CAM 03", "CAM 04" }
local camButtons = {}
local function exitCams()
	viewing = nil
	overlay.Visible = false
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = baseFOV
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then cam.CameraSubject = hum end
end

for i, name in ipairs(camNames) do
	local b = mk("TextButton", { BackgroundColor3 = Color3.fromRGB(20, 40, 26), TextColor3 = Color3.fromRGB(120, 255, 140), TextScaled = true, Font = Enum.Font.Code, Text = name, ZIndex = 8 }, btnRow)
	mk("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	b.MouseButton1Click:Connect(function()
		viewing = i
		camLabel.Text = name
		for n, other in pairs(camButtons) do
			other.BackgroundColor3 = n == i and Color3.fromRGB(40, 90, 50) or Color3.fromRGB(20, 40, 26)
		end
	end)
	camButtons[i] = b
end

local exitBtn = mk("TextButton", { Size = UDim2.new(0, 150, 0, 54), Position = UDim2.new(1, -160, 1, -64), BackgroundColor3 = Color3.fromRGB(120, 40, 40), TextColor3 = Color3.fromRGB(255, 230, 230), TextScaled = true, Font = Enum.Font.Arcade, Text = "EXIT", ZIndex = 8 }, overlay)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, exitBtn)
exitBtn.MouseButton1Click:Connect(exitCams)

openBtn.MouseButton1Click:Connect(function()
	overlay.Visible = not overlay.Visible
	if not overlay.Visible then
		exitCams()
	else
		baseFOV = workspace.CurrentCamera.FieldOfView
		viewing = viewing or 1
		camLabel.Text = camNames[viewing]
		for n, other in pairs(camButtons) do
			other.BackgroundColor3 = n == viewing and Color3.fromRGB(40, 90, 50) or Color3.fromRGB(20, 40, 26)
		end
	end
end)

remotes.GuestUpdate.OnClientEvent:Connect(function(data)
	if data.present then
		camApps[data.id] = data.cameraApp or "normal"
	else
		camApps[data.id] = nil
	end
end)

if camFolder then
	camFolder.DescendantAdded:Connect(function(d)
		if d:IsA("Model") and d:GetAttribute("GuestId") then
			guestModels[d:GetAttribute("GuestId")] = d
		end
	end)
	for _, d in ipairs(camFolder:GetDescendants()) do
		if d:IsA("Model") and d:GetAttribute("GuestId") then
			guestModels[d:GetAttribute("GuestId")] = d
		end
	end
end

local staticUntil = 0
remotes.PowerFlicker.OnClientEvent:Connect(function(duration)
	staticUntil = os.clock() + (duration or 10)
end)

-- RENDER LOOP: camera position, subtle static, hidden/distorted monsters
local staticLevel = 1
RunService.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera
	if overlay.Visible and viewing and camFolder then
		local camDef = camFolder:FindFirstChild("Cam" .. viewing)
		if camDef then
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = camDef.CFrame
			cam.FieldOfView = 75
		end
		-- static: rare short burst + quick fade so the feed stays watchable
		local powerOut = os.clock() &lt; staticUntil
		if powerOut then
			static.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
			static.BackgroundTransparency = 0.3
		else
			if math.random() &lt; 0.015 then
				staticLevel = 0.12
			end
			staticLevel = staticLevel + (1 - staticLevel) * 0.25
			static.BackgroundColor3 = Color3.fromRGB(210, 210, 210)
			static.BackgroundTransparency = staticLevel
		end
		-- moving scanline for the CRT feel
		scanline.Position = UDim2.new(0, 0, (os.clock() * 0.18) % 1, 0)
		-- hide / distort guests on camera
		for id, app in pairs(camApps) do
			local model = guestModels[id]
			if model and model.Parent then
				local hide = app == "absent"
				for _, p in ipairs(model:GetDescendants()) do
					if p:IsA("BasePart") then
						if hide then
							p.LocalTransparencyModifier = 1
						elseif app == "distorted" then
							p.LocalTransparencyModifier = 0.5 + 0.3 * math.abs(math.sin(os.clock() * 3))
						else
							p.LocalTransparencyModifier = 0
						end
					end
				end
			end
		end
	else
		static.BackgroundTransparency = 1
		-- restore guests when not viewing
		for id in pairs(camApps) do
			local model = guestModels[id]
			if model and model.Parent then
				for _, p in ipairs(model:GetDescendants()) do
					if p:IsA("BasePart") then
						p.LocalTransparencyModifier = 0
					end
				end
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX15"><Properties><string name="Name">DawnShopClient</string><ProtectedString name="Source">-- DawnShopClient v2: dawn summary, chore list, the dawn shop (Desk 2/3),
-- win/lose screens. Scale-based, scrollable, works on phones.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("NSM_Dawn")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "NSM_Dawn"
gui.ResetOnSpawn = false
gui.Parent = pg

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local desksBought = 1
local deskPrices = {}

-- DAWN SCREEN: near full-screen with a scrollable middle
local dawn = mk("Frame", { Size = UDim2.new(0.94, 0, 0.9, 0), Position = UDim2.new(0.03, 0, 0.05, 0), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.05, Visible = false, ZIndex = 9 }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 12) }, dawn)
mk("TextLabel", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 200, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "DAWN — YOU SURVIVED THE NIGHT", ZIndex = 10 }, dawn)

local scroll = mk("ScrollingFrame", { Size = UDim2.new(1, -16, 1, -110), Position = UDim2.new(0, 8, 0, 48), BackgroundTransparency = 1, ScrollBarThickness = 8, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 10 }, dawn)
mk("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

local function block(height, order)
	return mk("Frame", { LayoutOrder = order, Size = UDim2.new(1, -12, 0, height), BackgroundTransparency = 1, ZIndex = 10 }, scroll)
end

local summary = mk("TextLabel", { Size = UDim2.new(1, -8, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(220, 220, 230), TextSize = 20, Font = Enum.Font.Gotham, Text = "", TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 10 }, block(120, 1))
local choresTitle = mk("TextLabel", { Size = UDim2.new(1, -8, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 120, 120), TextScaled = true, Font = Enum.Font.Arcade, Text = "MORNING CHORES", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 10 }, block(28, 2))
local choresText = mk("TextLabel", { Size = UDim2.new(1, -8, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(220, 220, 230), TextSize = 18, Font = Enum.Font.Gotham, Text = "", TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 10 }, block(130, 3))
local shopTitle = mk("TextLabel", { Size = UDim2.new(1, -8, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(120, 255, 140), TextScaled = true, Font = Enum.Font.Arcade, Text = "MOTEL UPGRADES", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 10 }, block(28, 4))
local deskRow = block(50, 5)
mk("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 1, 0), CellPadding = UDim2.new(0, 6, 0, 0) }, deskRow)

local deskButtons = {}
for slot = 2, 3 do
	local b = mk("TextButton", { BackgroundColor3 = Color3.fromRGB(30, 90, 140), TextColor3 = Color3.fromRGB(230, 245, 255), TextScaled = true, Font = Enum.Font.GothamBold, Text = "DESK " .. slot, ZIndex = 11 }, deskRow)
	mk("UICorner", { CornerRadius = UDim.new(0, 8) }, b)
	b.MouseButton1Click:Connect(function()
		remotes.Shop:FireServer("buyDesk", slot)
	end)
	deskButtons[slot] = b
end

local bottomRow = mk("Frame", { Size = UDim2.new(1, -16, 0, 50), Position = UDim2.new(0, 8, 1, -58), BackgroundTransparency = 1, ZIndex = 10 }, dawn)
local shopBtn = mk("TextButton", { Size = UDim2.new(0.5, -6, 1, 0), BackgroundColor3 = Color3.fromRGB(60, 60, 80), TextColor3 = Color3.fromRGB(230, 230, 240), TextScaled = true, Font = Enum.Font.Arcade, Text = "DESK HELP", ZIndex = 11 }, bottomRow)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, shopBtn)
local startBtn = mk("TextButton", { Size = UDim2.new(0.5, -6, 1, 0), Position = UDim2.new(0.5, 6, 0, 0), BackgroundColor3 = Color3.fromRGB(30, 120, 50), TextColor3 = Color3.fromRGB(230, 255, 230), TextScaled = true, Font = Enum.Font.Arcade, Text = "START NEXT NIGHT", ZIndex = 11 }, bottomRow)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, startBtn)
startBtn.MouseButton1Click:Connect(function()
	dawn.Visible = false
	remotes.NextNight:FireServer()
end)
shopBtn.MouseButton1Click:Connect(function()
	shopTitle.Text = "Desks: one per player. Solo players cannot use extra desks."
end)

remotes.Dawn.OnClientEvent:Connect(function(payload)
	summary.Text = "Night " .. payload.night .. " summary:\nMoney earned: $" .. payload.earned .. "\nCorrect calls: " .. payload.correct .. "\nWrong calls: " .. payload.wrong .. "\nMonsters caught: " .. payload.caught
	local txt = ""
	if #payload.chores == 0 then
		txt = "All rooms are clean. Nothing to do."
	else
		for _, ch in ipairs(payload.chores) do
			local what = ch.kind == "messy" and "needs cleaning" or "guest won't leave"
			txt = txt .. "Room " .. ch.room .. " — " .. what .. "\n"
		end
		txt = txt .. "\nWalk to each room to fix it. All chores done: +$10 and +5 reputation."
	end
	choresText.Text = txt
	dawn.Visible = true
end)

remotes.StateUpdate.OnClientEvent:Connect(function(s)
	desksBought = s.desksBought
	deskPrices = s.deskPrices or {}
	for slot, b in pairs(deskButtons) do
		if slot &lt;= desksBought then
			b.Text = "DESK " .. slot .. " — OWNED"
			b.BackgroundColor3 = Color3.fromRGB(40, 60, 40)
		elseif #Players:GetPlayers() &lt; slot then
			b.Text = "DESK " .. slot .. " — $" .. (deskPrices[slot] or 0) .. " (needs a friend)"
			b.BackgroundColor3 = Color3.fromRGB(60, 60, 66)
		else
			b.Text = "DESK " .. slot .. " — $" .. (deskPrices[slot] or 0)
			b.BackgroundColor3 = Color3.fromRGB(30, 90, 140)
		end
	end
end)

-- WIN / LOSE SCREENS
local endFrame = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.25, Visible = false, ZIndex = 12 }, gui)
local endTitle = mk("TextLabel", { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.26, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "", ZIndex = 13 }, endFrame)
local endSub = mk("TextLabel", { Size = UDim2.new(0.84, 0, 0.07, 0), Position = UDim2.new(0.08, 0, 0.4, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(230, 230, 240), TextScaled = true, Font = Enum.Font.Gotham, Text = "", TextWrapped = true, ZIndex = 13 }, endFrame)
local againBtn = mk("TextButton", { Size = UDim2.new(0.5, 0, 0.09, 0), Position = UDim2.new(0.25, 0, 0.52, 0), BackgroundColor3 = Color3.fromRGB(30, 120, 50), TextColor3 = Color3.fromRGB(230, 255, 230), TextScaled = true, Font = Enum.Font.Arcade, Text = "PLAY AGAIN", ZIndex = 13 }, endFrame)
mk("UICorner", { CornerRadius = UDim.new(0, 10) }, againBtn)
againBtn.MouseButton1Click:Connect(function()
	endFrame.Visible = false
	remotes.NextNight:FireServer()
end)

remotes.EndScreen.OnClientEvent:Connect(function(win, data)
	if win then
		endTitle.Text = "YOU SURVIVED ALL 5 NIGHTS"
		endSub.Text = "Final money: $" .. tostring(data.money) .. "   Reputation: " .. tostring(data.stars) .. " stars"
		againBtn.Text = "PLAY AGAIN"
	else
		endTitle.Text = "GAME OVER"
		endSub.Text = "The motel is lost on night " .. tostring(data.night) .. "."
		againBtn.Text = "RETRY NIGHT"
	end
	endFrame.Visible = true
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX16"><Properties><string name="Name">DeskClient</string><ProtectedString name="Source">-- DeskClient v2: mobile-first bottom dock. Full width, horizontal scrolling
-- question buttons, big decision buttons, ID card, overstayer morning dialog.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("NSM_Desk")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "NSM_Desk"
gui.ResetOnSpawn = false
gui.Parent = pg

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local myDesk = nil
local guests = {}
local cleanRooms = true
local currentId = nil

-- BOTTOM DOCK: full width so nothing is cut off on phones
local panel = mk("Frame", { Size = UDim2.new(1, -12, 0, 248), Position = UDim2.new(0, 6, 1, -254), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.12, BorderSizePixel = 0, Visible = false }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 10) }, panel)

local nameLabel = mk("TextLabel", { Size = UDim2.new(1, -12, 0, 28), Position = UDim2.new(0, 6, 0, 4), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "GUEST", TextXAlignment = Enum.TextXAlignment.Left }, panel)
local speech = mk("TextLabel", { Size = UDim2.new(1, -12, 0, 42), Position = UDim2.new(0, 6, 0, 34), BackgroundColor3 = Color3.fromRGB(28, 28, 36), TextColor3 = Color3.fromRGB(240, 240, 240), TextScaled = true, Font = Enum.Font.Gotham, Text = "...", TextWrapped = true }, panel)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, speech)

local idCard = mk("Frame", { Size = UDim2.new(1, -12, 0, 52), Position = UDim2.new(0, 6, 0, 80), BackgroundColor3 = Color3.fromRGB(210, 200, 170), Visible = false }, panel)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, idCard)
local idText = mk("TextLabel", { Size = UDim2.new(1, -10, 1, -6), Position = UDim2.new(0, 5, 0, 3), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(35, 30, 25), TextScaled = true, Font = Enum.Font.Code, Text = "ID CARD", TextWrapped = true }, idCard)

-- QUESTION BUTTONS: horizontally scrollable row (never squeezed on small screens)
local qScroll = mk("ScrollingFrame", { Size = UDim2.new(1, -12, 0, 48), Position = UDim2.new(0, 6, 0, 138), BackgroundTransparency = 1, ScrollBarThickness = 4, ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.X, ElasticBehavior = Enum.ElasticBehavior.WhenScrollable }, panel)
mk("UIListLayout", { Padding = UDim.new(0, 8), FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder }, qScroll)

local questions = {
	{ id = "from", text = "Where are you traveling from?" },
	{ id = "id", text = "Can I see your ID?" },
	{ id = "year", text = "What year is it?" },
	{ id = "job", text = "What is your job?" },
	{ id = "stay", text = "How long are you staying?" },
}

local function makeQButton(q, order)
	local b = mk("TextButton", { LayoutOrder = order, Size = UDim2.new(0, 170, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 40, 56), BackgroundTransparency = 0.2, TextColor3 = Color3.fromRGB(200, 220, 255), TextScaled = true, Font = Enum.Font.Gotham, Text = q.text }, qScroll)
	mk("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	b.MouseButton1Click:Connect(function()
		if currentId then
			remotes.Ask:FireServer(currentId, q.id)
		end
	end)
end
for i, q in ipairs(questions) do
	makeQButton(q, i)
end

-- DECISION BUTTONS: big, side by side, full width
local decisionRow = mk("Frame", { Size = UDim2.new(1, -12, 0, 54), Position = UDim2.new(0, 6, 1, -60), BackgroundTransparency = 1 }, panel)
local admitBtn = mk("TextButton", { Size = UDim2.new(0.5, -6, 1, 0), BackgroundColor3 = Color3.fromRGB(30, 120, 50), TextColor3 = Color3.fromRGB(230, 255, 230), TextScaled = true, Font = Enum.Font.Arcade, Text = "GIVE ROOM KEY" }, decisionRow)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, admitBtn)
local denyBtn = mk("TextButton", { Size = UDim2.new(0.5, -6, 1, 0), Position = UDim2.new(0.5, 6, 0, 0), BackgroundColor3 = Color3.fromRGB(150, 40, 40), TextColor3 = Color3.fromRGB(255, 230, 230), TextScaled = true, Font = Enum.Font.Arcade, Text = "TURN AWAY" }, decisionRow)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, denyBtn)

admitBtn.MouseButton1Click:Connect(function()
	if currentId then remotes.Decide:FireServer(currentId, true) end
end)
denyBtn.MouseButton1Click:Connect(function()
	if currentId then remotes.Decide:FireServer(currentId, false) end
end)

-- SEAT TRACKING
local function trackSeat()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		local seat = hum.SeatPart
		if seat and seat.Name:sub(1, 8) == "DeskSeat" then
			myDesk = tonumber(seat.Name:sub(9))
		else
			myDesk = nil
		end
	end
end

task.spawn(function()
	while true do
		task.wait(0.4)
		trackSeat()
		local guest = myDesk and guests[myDesk]
		panel.Visible = guest ~= nil
		if guest then
			currentId = guest.id
			nameLabel.Text = (guest.angry and "[ANGRY] " or "") .. guest.name
		else
			currentId = nil
		end
		admitBtn.Text = cleanRooms and "GIVE ROOM KEY" or "NO CLEAN ROOMS"
	end
end)

remotes.GuestUpdate.OnClientEvent:Connect(function(data)
	if data.present then
		guests[data.desk] = data
		speech.Text = "..."
		idCard.Visible = false
	else
		if guests[data.desk] and guests[data.desk].id == data.id then
			guests[data.desk] = nil
		end
	end
end)

remotes.Answer.OnClientEvent:Connect(function(guestId, qid, text, idCardData)
	if currentId ~= guestId then return end
	speech.Text = text
	if qid == "id" and idCardData then
		idCard.Visible = true
		idText.Text = "GUEST ID\nName: " .. idCardData.name .. "\nFrom: " .. idCardData.from .. "   Stay: " .. idCardData.stay
	end
end)

remotes.StateUpdate.OnClientEvent:Connect(function(s)
	cleanRooms = false
	for _, r in ipairs(s.rooms) do
		if r.state == "clean" then cleanRooms = true end
	end
end)

-- MORNING CHORE DIALOG (overstayer): centered, scale-sized
local choreFrame = mk("Frame", { Size = UDim2.new(0.92, 0, 0.46, 0), Position = UDim2.new(0.04, 0, 0.27, 0), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.1, Visible = false, ZIndex = 9 }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 10) }, choreFrame)
local choreTitle = mk("TextLabel", { Size = UDim2.new(1, -12, 0, 30), Position = UDim2.new(0, 6, 0, 4), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "ROOM — GUEST WON'T LEAVE", ZIndex = 10 }, choreFrame)
local choreArg = mk("TextLabel", { Size = UDim2.new(1, -12, 0.3, 0), Position = UDim2.new(0, 6, 0, 40), BackgroundColor3 = Color3.fromRGB(28, 28, 36), TextColor3 = Color3.fromRGB(240, 240, 240), TextScaled = true, Font = Enum.Font.Gotham, Text = "", TextWrapped = true, ZIndex = 10 }, choreFrame)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, choreArg)
local choreChoices = mk("Frame", { Size = UDim2.new(1, -12, 0.42, 0), Position = UDim2.new(0, 6, 0.52, 0), BackgroundTransparency = 1, ZIndex = 10 }, choreFrame)
mk("UIListLayout", { Padding = UDim.new(0, 6) }, choreChoices)
local choreRoom = nil

local choiceTexts = {
	"Okay, sleep in then.",
	"Checkout was at dawn, you have to leave now.",
	"Take your time, sir.",
}
for i, txt in ipairs(choiceTexts) do
	local b = mk("TextButton", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = i == 2 and Color3.fromRGB(30, 90, 140) or Color3.fromRGB(50, 50, 60), TextColor3 = Color3.fromRGB(240, 240, 240), TextScaled = true, Font = Enum.Font.Gotham, Text = txt, ZIndex = 11 }, choreChoices)
	mk("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
	b.MouseButton1Click:Connect(function()
		if choreRoom then
			remotes.ChoreReply:FireServer(choreRoom, i)
		end
		choreFrame.Visible = false
	end)
end

remotes.ChoreDialog.OnClientEvent:Connect(function(room, argument)
	choreRoom = room
	choreTitle.Text = "ROOM " .. tostring(room) .. " — GUEST WON'T LEAVE"
	choreArg.Text = '"' .. argument .. '"'
	choreFrame.Visible = true
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX17"><Properties><string name="Name">HUD</string><ProtectedString name="Source">-- HUD v2: mobile-first scale-based layout. Money/rep/night/queue top bar,
-- sanity bar bottom-center, notifications, title cards, hunt overlay,
-- quick chat (right edge, clear of the touch controls), downed overlay, screen shake.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("NSM_HUD")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "NSM_HUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.Parent = pg

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local state = { money = 0, stars = 1, night = 1, phase = "Lobby", queueLeft = 0, sanity = 100, hints = false }

-- TOP BAR (full width, scales to any phone)
local top = mk("Frame", { Size = UDim2.new(1, -12, 0, 78), Position = UDim2.new(0, 6, 0, 6), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.25, BorderSizePixel = 0 }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, top)
local moneyLabel = mk("TextLabel", { Size = UDim2.new(0.5, -8, 0, 24), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(120, 255, 140), TextScaled = true, Font = Enum.Font.Arcade, Text = "$0", TextXAlignment = Enum.TextXAlignment.Left }, top)
local repLabel = mk("TextLabel", { Size = UDim2.new(0.5, -8, 0, 24), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "REP: *", TextXAlignment = Enum.TextXAlignment.Right }, top)
local nightLabel = mk("TextLabel", { Size = UDim2.new(0.5, -8, 0, 24), Position = UDim2.new(0, 0, 0, 26), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 90, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "NIGHT 1", TextXAlignment = Enum.TextXAlignment.Left }, top)
local queueLabel = mk("TextLabel", { Size = UDim2.new(0.5, -8, 0, 24), Position = UDim2.new(0.5, 0, 0, 26), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(200, 200, 210), TextScaled = true, Font = Enum.Font.Arcade, Text = "Guests left: 0", TextXAlignment = Enum.TextXAlignment.Right }, top)
local objectiveLabel = mk("TextLabel", { Size = UDim2.new(1, -8, 0, 24), Position = UDim2.new(0, 4, 0, 52), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(180, 180, 190), TextScaled = true, Font = Enum.Font.Gotham, Text = "", TextWrapped = true }, top)

-- SANITY BAR (bottom center, scale width)
local sanityBack = mk("Frame", { Size = UDim2.new(0.55, 0, 0, 28), Position = UDim2.new(0.225, 0, 1, -36), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.25, BorderSizePixel = 0 }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, sanityBack)
local sanityFill = mk("Frame", { Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0, 3, 0, 3), BackgroundColor3 = Color3.fromRGB(120, 200, 255), BorderSizePixel = 0 }, sanityBack)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, sanityFill)
local sanityNum = mk("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 255, 255), TextScaled = true, Font = Enum.Font.Arcade, Text = "SANITY 100", ZIndex = 2 }, sanityBack)
local lowWarn = mk("TextLabel", { Size = UDim2.new(0.4, 0, 0, 26), Position = UDim2.new(0.3, 0, 1, -94), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 60, 60), TextScaled = true, Font = Enum.Font.Arcade, Text = "LOW SANITY", Visible = false, ZIndex = 3 }, gui)

-- COFFEE / WARMER STATUS (above the sanity bar)
local warmerLabel = mk("TextLabel", { Size = UDim2.new(0.55, 0, 0, 22), Position = UDim2.new(0.225, 0, 1, -62), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.4, TextColor3 = Color3.fromRGB(255, 200, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "Coffee warmer: brewing...", Visible = false }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, warmerLabel)

-- NOTIFICATIONS (top center, below the top bar)
local notifyArea = mk("Frame", { Size = UDim2.new(0.72, 0, 0, 280), Position = UDim2.new(0.14, 0, 0, 90), BackgroundTransparency = 1 }, gui)
mk("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }, notifyArea)

local function notify(text, kind)
	local colors = { good = Color3.fromRGB(120, 255, 140), bad = Color3.fromRGB(255, 90, 90), guest = Color3.fromRGB(255, 220, 90), info = Color3.fromRGB(190, 190, 200) }
	local label = mk("TextLabel", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.25, TextColor3 = colors[kind] or colors.info, TextScaled = true, Font = Enum.Font.Arcade, Text = text }, notifyArea)
	mk("UICorner", { CornerRadius = UDim.new(0, 8) }, label)
	task.delay(4, function()
		if label.Parent then label:Destroy() end
	end)
end
remotes.Notify.OnClientEvent:Connect(notify)

-- TITLE CARD
local titleCard = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.35, Visible = false, ZIndex = 5 }, gui)
local titleNight = mk("TextLabel", { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.18, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 60, 60), TextScaled = true, Font = Enum.Font.Arcade, Text = "NIGHT 1", ZIndex = 6 }, titleCard)
local titleObj = mk("TextLabel", { Size = UDim2.new(0.84, 0, 0.05, 0), Position = UDim2.new(0.08, 0, 0.32, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(230, 230, 240), TextScaled = true, Font = Enum.Font.Gotham, Text = "", TextWrapped = true, ZIndex = 6 }, titleCard)
local titleRules = mk("TextLabel", { Size = UDim2.new(0.8, 0, 0.3, 0), Position = UDim2.new(0.1, 0, 0.39, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true, Font = Enum.Font.Gotham, Text = "", TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 6 }, titleCard)
local hintLabel = mk("TextLabel", { Size = UDim2.new(0.86, 0, 0.08, 0), Position = UDim2.new(0.07, 0, 0.78, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(160, 220, 255), TextScaled = true, Font = Enum.Font.Gotham, Text = "", TextWrapped = true, ZIndex = 6 }, titleCard)

remotes.TitleCard.OnClientEvent:Connect(function(night, objective, newRules, hints)
	titleNight.Text = "NIGHT " .. night
	titleObj.Text = objective
	local txt = ""
	for _, r in ipairs(newRules or {}) do
		txt = txt .. "NEW RULE: " .. r .. "\n\n"
	end
	titleRules.Text = txt
	hintLabel.Text = hints and ("TUTORIAL: Walk to the desk and press Sit. Then use INSPECT, QUESTIONS, CAMERAS and the HANDBOOK before you ADMIT or TURN AWAY.") or ""
	titleCard.Visible = true
	task.delay(7, function() titleCard.Visible = false end)
end)

-- HUNT OVERLAY (below the top bar so it never overlaps it)
local huntOverlay = mk("TextLabel", { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.new(0, 0, 0, 90), BackgroundColor3 = Color3.fromRGB(80, 0, 0), BackgroundTransparency = 0.2, TextColor3 = Color3.fromRGB(255, 60, 60), TextScaled = true, Font = Enum.Font.Arcade, Text = "LOCKDOWN — SOMETHING IS IN THE ROOMS", Visible = false, ZIndex = 4 }, gui)
local huntTimerLabel = mk("TextLabel", { Size = UDim2.new(0.4, 0, 0, 38), Position = UDim2.new(0.3, 0, 0, 140), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.3, TextColor3 = Color3.fromRGB(255, 120, 120), TextScaled = true, Font = Enum.Font.Arcade, Text = "", Visible = false, ZIndex = 4 }, gui)

remotes.HuntState.OnClientEvent:Connect(function(active, timeLeft)
	huntOverlay.Visible = active
	huntTimerLabel.Visible = active
	if active then
		huntTimerLabel.Text = "DAWN IN " .. tostring(timeLeft) .. "s"
	end
end)

-- DOWNED OVERLAY
local downedOverlay = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 0, 0), BackgroundTransparency = 0.45, Visible = false, ZIndex = 7 }, gui)
mk("TextLabel", { Size = UDim2.new(1, 0, 0.1, 0), Position = UDim2.new(0, 0, 0.38, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 80, 80), TextScaled = true, Font = Enum.Font.Arcade, Text = "YOU WERE CAUGHT", ZIndex = 8 }, downedOverlay)
remotes.Downed.OnClientEvent:Connect(function(isDowned)
	downedOverlay.Visible = isDowned and true or false
end)

-- QUICK CHAT (right edge, middle height: clear of thumbstick and jump button)
local quickTexts = { "I think this one is fake", "Check the cameras", "Hide!", "It's safe" }
local qcFrame = mk("Frame", { Size = UDim2.new(0, 170, 0, 168), Position = UDim2.new(1, -178, 0.32, 0), BackgroundTransparency = 1 }, gui)
mk("UIListLayout", { Padding = UDim.new(0, 6) }, qcFrame)
for _, txt in ipairs(quickTexts) do
	local b = mk("TextButton", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Color3.fromRGB(30, 30, 42), BackgroundTransparency = 0.2, TextColor3 = Color3.fromRGB(255, 240, 170), TextScaled = true, Font = Enum.Font.GothamBold, Text = txt }, qcFrame)
	mk("UICorner", { CornerRadius = UDim.new(0, 8) }, b)
	b.MouseButton1Click:Connect(function()
		remotes.QuickChat:FireServer(txt)
	end)
end

-- SCREEN SHAKE
remotes.Shake.OnClientEvent:Connect(function(intensity)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local t0 = os.clock()
	while os.clock() - t0 &lt; 0.6 do
		hum.CameraOffset = Vector3.new(math.random(-10, 10) / 10 * intensity, math.random(-10, 10) / 10 * intensity, 0)
		RunService.RenderStepped:Wait()
	end
	hum.CameraOffset = Vector3.new()
end)

-- STATE + SANITY
local function starsText(n)
	local s = ""
	for i = 1, 5 do
		s = s .. (i &lt;= n and "*" or "-")
	end
	return s
end

remotes.StateUpdate.OnClientEvent:Connect(function(s)
	state.money = s.money
	state.stars = s.stars
	state.night = s.night
	state.phase = s.phase
	state.queueLeft = s.queueLeft
	state.hints = s.hints
	moneyLabel.Text = "$" .. tostring(s.money)
	repLabel.Text = "REP: " .. starsText(s.stars)
	nightLabel.Text = "NIGHT " .. tostring(s.night)
	queueLabel.Text = "Guests left: " .. tostring(s.queueLeft)
	objectiveLabel.Text = s.objective or ""
end)

remotes.Sanity.OnClientEvent:Connect(function(v)
	state.sanity = v
	sanityFill.Size = UDim2.new(math.clamp(v / 100, 0, 1), -6, 1, -6)
	sanityFill.BackgroundColor3 = v &gt; 50 and Color3.fromRGB(120, 200, 255) or (v &gt; 25 and Color3.fromRGB(255, 200, 90) or Color3.fromRGB(255, 60, 60))
	sanityNum.Text = "SANITY " .. tostring(math.floor(v))
end)

-- LOW SANITY FLASH + WARMER DISPLAY
task.spawn(function()
	local warmerReadyAt, warmerMinutes = nil, 20
	remotes.StateUpdate.OnClientEvent:Connect(function(s)
		warmerReadyAt = s.warmerReadyAt
		warmerMinutes = s.warmerMinutes
	end)
	while true do
		task.wait(0.5)
		lowWarn.Visible = state.sanity &lt; 25 and (os.clock() % 1 &lt; 0.5)
		if warmerReadyAt then
			warmerLabel.Visible = true
			local left = warmerReadyAt - workspace:GetServerTimeNow()
			if left &lt;= 0 then
				warmerLabel.Text = "COFFEE READY at the warmer! (+50 sanity)"
			else
				warmerLabel.Text = string.format("Warmer pot: %d:%02d", math.floor(left / 60), math.floor(left % 60))
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX18"><Properties><string name="Name">HandbookClient</string><ProtectedString name="Source">-- HandbookClient v2: the rule book as a full-screen scrollable page.
-- Night 1: 3 rules, each night adds more. Scrambles during hallucinations.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("NSM_Handbook")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "NSM_Handbook"
gui.ResetOnSpawn = false
gui.Parent = pg

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local rules = {}
local revealed = 3

local openBtn = mk("TextButton", { Size = UDim2.new(0, 140, 0, 44), Position = UDim2.new(0, 8, 0.5, -52), BackgroundColor3 = Color3.fromRGB(90, 60, 30), TextColor3 = Color3.fromRGB(255, 230, 170), TextScaled = true, Font = Enum.Font.Arcade, Text = "HANDBOOK" }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, openBtn)

local book = mk("Frame", { Size = UDim2.new(0.94, 0, 0.84, 0), Position = UDim2.new(0.03, 0, 0.08, 0), BackgroundColor3 = Color3.fromRGB(214, 202, 168), Visible = false, ZIndex = 9 }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 12) }, book)
mk("TextLabel", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(70, 50, 30), TextScaled = true, Font = Enum.Font.Arcade, Text = "MOTEL HANDBOOK — NIGHT SHIFT RULES", ZIndex = 10 }, book)

local scroll = mk("ScrollingFrame", { Size = UDim2.new(1, -24, 1, -110), Position = UDim2.new(0, 12, 0, 50), BackgroundTransparency = 1, ScrollBarThickness = 8, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 10 }, book)
local rulesText = mk("TextLabel", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(45, 35, 25), TextSize = 20, Font = Enum.Font.Gotham, Text = "", TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 10 }, scroll)
local closeBtn = mk("TextButton", { Size = UDim2.new(0, 170, 0, 46), Position = UDim2.new(0.5, -85, 1, -54), BackgroundColor3 = Color3.fromRGB(70, 50, 30), TextColor3 = Color3.fromRGB(255, 230, 170), TextScaled = true, Font = Enum.Font.Arcade, Text = "CLOSE BOOK", ZIndex = 10 }, book)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, closeBtn)

local function refresh()
	local txt = ""
	for i = 1, math.min(revealed, #rules) do
		txt = txt .. i .. ". " .. rules[i] .. "\n\n"
	end
	rulesText.Text = txt
end

openBtn.MouseButton1Click:Connect(function()
	book.Visible = not book.Visible
	refresh()
end)
closeBtn.MouseButton1Click:Connect(function()
	book.Visible = false
end)

remotes.StateUpdate.OnClientEvent:Connect(function(s)
	rules = s.ruleTexts or {}
	revealed = s.rules or 3
	if book.Visible then refresh() end
end)

-- HALLUCINATION: handbook text scrambles for 5 seconds at a time
local glyphs = { "#", "%", "&amp;", "@", "?", "/", "\\", "~", "=", "+" }
local function scramble(s)
	local out = {}
	for i = 1, #s do
		local c = s:sub(i, i)
		if c == "\n" or c == " " then
			table.insert(out, c)
		elseif math.random() &lt; 0.55 then
			table.insert(out, glyphs[math.random(#glyphs)])
		else
			table.insert(out, c)
		end
	end
	return table.concat(out)
end

task.spawn(function()
	while true do
		task.wait(math.random(20, 40))
		if _G.NSM_Hallucinating and book.Visible then
			local original = rulesText.Text
			rulesText.Text = scramble(original)
			task.wait(5)
			refresh()
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX19"><Properties><string name="Name">InspectClient</string><ProtectedString name="Source">-- InspectClient: click a guest (or press INSPECT) to zoom to their face,
-- then Inspect hands / Inspect face. Shows found tells.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local pg = player:WaitForChild("PlayerGui")

local old = pg:FindFirstChild("NSM_Inspect")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "NSM_Inspect"
gui.ResetOnSpawn = false
gui.Parent = pg

local function mk(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local inspecting = nil
local zooming = false

local frame = mk("Frame", { Size = UDim2.new(0.9, 0, 0.42, 0), Position = UDim2.new(0.05, 0, 0.29, 0), BackgroundColor3 = Color3.fromRGB(16, 16, 22), BackgroundTransparency = 0.1, Visible = false, ZIndex = 9 }, gui)
mk("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)
mk("UISizeConstraint", { MaxSize = Vector2.new(460, 340) }, frame)
local title = mk("TextLabel", { Size = UDim2.new(1, -12, 0, 30), Position = UDim2.new(0, 6, 0, 4), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 220, 90), TextScaled = true, Font = Enum.Font.Arcade, Text = "INSPECTION", ZIndex = 10 }, frame)
local result = mk("TextLabel", { Size = UDim2.new(1, -12, 0.38, 0), Position = UDim2.new(0, 6, 0, 38), BackgroundColor3 = Color3.fromRGB(28, 28, 36), TextColor3 = Color3.fromRGB(240, 240, 240), TextScaled = true, Font = Enum.Font.Gotham, Text = "Look closely...", TextWrapped = true, ZIndex = 10 }, frame)
mk("UICorner", { CornerRadius = UDim.new(0, 6) }, result)

local handsBtn = mk("TextButton", { Size = UDim2.new(1, -12, 0, 44), Position = UDim2.new(0, 6, 1, -98), BackgroundColor3 = Color3.fromRGB(40, 40, 56), TextColor3 = Color3.fromRGB(200, 220, 255), TextScaled = true, Font = Enum.Font.GothamBold, Text = "INSPECT HANDS", ZIndex = 10 }, frame)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, handsBtn)
local faceBtn = mk("TextButton", { Size = UDim2.new(1, -12, 0, 44), Position = UDim2.new(0, 6, 1, -50), BackgroundColor3 = Color3.fromRGB(40, 40, 56), TextColor3 = Color3.fromRGB(200, 220, 255), TextScaled = true, Font = Enum.Font.GothamBold, Text = "INSPECT FACE", ZIndex = 10 }, frame)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, faceBtn)
local closeBtn = mk("TextButton", { Size = UDim2.new(0, 100, 0, 32), Position = UDim2.new(1, -106, 0, 4), BackgroundColor3 = Color3.fromRGB(120, 40, 40), TextColor3 = Color3.fromRGB(255, 230, 230), TextScaled = true, Font = Enum.Font.Arcade, Text = "CLOSE", ZIndex = 10 }, frame)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, closeBtn)

local function closeInspect()
	frame.Visible = false
	inspecting = nil
	if zooming then
		zooming = false
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Custom
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then cam.CameraSubject = hum end
	end
end
closeBtn.MouseButton1Click:Connect(closeInspect)

handsBtn.MouseButton1Click:Connect(function()
	if inspecting then remotes.Inspect:FireServer(inspecting, "Hands") end
end)
faceBtn.MouseButton1Click:Connect(function()
	if inspecting then remotes.Inspect:FireServer(inspecting, "Face") end
end)

local function startInspect(guestId)
	inspecting = guestId
	remotes.Inspect:FireServer(guestId, "open")
end

remotes.InspectResult.OnClientEvent:Connect(function(guestId, kind, labels, headCF)
	if guestId ~= inspecting then return end
	if kind == "open" then
		frame.Visible = true
		result.Text = "Look closely..."
		if headCF then
			zooming = true
			local cam = workspace.CurrentCamera
			cam.CameraType = Enum.CameraType.Scriptable
			local target = headCF * CFrame.new(0, 0.1, 4.2)
			TweenService:Create(cam, TweenInfo.new(0.5), { CFrame = target }):Play()
		end
	else
		local txt
		if #labels == 0 then
			txt = "Looks normal."
		else
			txt = ""
			for _, l in ipairs(labels) do
				txt = txt .. "!! " .. l .. "\n"
			end
		end
		if _G.NSM_Hallucinating and #labels == 0 and math.random() &lt; 0.3 then
			txt = "!! Six fingers on one hand"
			task.delay(3, function()
				if result.Text == txt then
					result.Text = "Looks normal."
				end
			end)
		end
		result.Text = txt
	end
end)

-- Click any guest to inspect (works with touch)
local map = workspace:FindFirstChild("Map")
if map then
	map.DescendantAdded:Connect(function(d)
		if d:IsA("ClickDetector") and d.Parent and d.Parent:FindFirstChild("HumanoidRootPart") then
			d.MouseClick:Connect(function()
				local guestId = d.Parent:GetAttribute("GuestId")
				if guestId then startInspect(guestId) end
			end)
		end
	end)
end
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX20"><Properties><string name="Name">SanityClient</string><ProtectedString name="Source">-- SanityClient: hallucinations at 0 sanity. Visual and audio ONLY —
-- they never change real guest data.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local pg = player:WaitForChild("PlayerGui")

local hallucinating = false
_G.NSM_Hallucinating = false

local cc = Instance.new("ColorCorrectionEffect")
cc.Name = "NSM_HallucinationCC"
cc.Parent = Lighting

local whisper = Instance.new("Sound")
whisper.SoundId = "rbxasset://sounds/swoosh.wav"
whisper.Looped = true
whisper.Volume = 0
whisper.Pitch = 0.4
whisper.Parent = workspace

local heartbeat = Instance.new("Sound")
heartbeat.SoundId = "rbxasset://sounds/bass.wav"
heartbeat.Looped = true
heartbeat.Volume = 0
heartbeat.Pitch = 1.6
heartbeat.Parent = workspace

remotes.Hallucinate.OnClientEvent:Connect(function(on)
	hallucinating = on
	_G.NSM_Hallucinating = on
	if not on then
		cc.TintColor = Color3.new(1, 1, 1)
		cc.Saturation = 0
		whisper.Volume = 0
	end
end)

remotes.Sanity.OnClientEvent:Connect(function(v)
	heartbeat.Volume = (v &lt; 25 or _G.NSM_Hunting) and 0.35 or 0
end)
remotes.HuntState.OnClientEvent:Connect(function(active)
	_G.NSM_Hunting = active
end)

-- FAKE GUEST (client-side only, vanishes when inspected/questioned)
local function spawnFakeGuest()
	local map = workspace:FindFirstChild("Map")
	local desk = map and map:FindFirstChild("DeskFurniture1")
	if not desk then return end
	local model = Instance.new("Model")
	model.Name = "FakeGuest"
	local hrp = Instance.new("Part")
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CFrame = CFrame.new(0, 3.5, -11)
	hrp.Anchored = true
	hrp.Parent = model
	for _, def in ipairs({
		{ size = Vector3.new(2, 2, 1), off = CFrame.new() },
		{ size = Vector3.new(1.4, 1.4, 1.4), off = CFrame.new(0, 1.7, 0) },
		{ size = Vector3.new(0.95, 2, 0.95), off = CFrame.new(-1.5, 0, 0) },
		{ size = Vector3.new(0.95, 2, 0.95), off = CFrame.new(1.5, 0, 0) },
		{ size = Vector3.new(0.9, 2, 0.9), off = CFrame.new(-0.55, -2, 0) },
		{ size = Vector3.new(0.9, 2, 0.9), off = CFrame.new(0.55, -2, 0) },
	}) do
		local p = Instance.new("Part")
		p.Size = def.size
		p.CFrame = hrp.CFrame * def.off
		p.Anchored = true
		p.CanCollide = false
		p.Color = Color3.fromRGB(30, 30, 34)
		p.Transparency = 0.35
		p.Parent = model
	end
	local head = model:GetChildren()[2]
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 20
	cd.Parent = head
	model.Parent = map
	local vanished = false
	local function vanish()
		if vanished then return end
		vanished = true
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then p.Transparency = 1 end
		end
		local burst = Instance.new("Sound")
		burst.SoundId = "rbxasset://sounds/flashbulb.wav"
		burst.Volume = 1
		burst.Parent = head
		burst:Play()
		game:GetService("Debris"):AddItem(model, 1)
		remotes.Notify:FireServer("it was never there")
	end
	cd.MouseClick:Connect(vanish)
	task.delay(math.random(8, 16), vanish)
end

-- HALLUCINATION LOOP
task.spawn(function()
	local t0 = os.clock()
	while true do
		RunService.RenderStepped:Wait()
		if hallucinating then
			local t = os.clock() - t0
			cc.TintColor = Color3.fromRGB(255, 200 + math.sin(t * 2) * 40, 200 + math.cos(t * 3) * 40)
			cc.Saturation = math.sin(t * 1.5) * 0.4
			whisper.Volume = 0.25 + math.abs(math.sin(t)) * 0.2
			local cam = workspace.CurrentCamera
			if cam and cam.CameraType == Enum.CameraType.Custom then
				cam.FieldOfView = 70 + math.sin(t * 1.2) * 6
			end
			if math.random() &lt; 0.002 then
				spawnFakeGuest()
			end
			if math.random() &lt; 0.001 then
				local map = workspace:FindFirstChild("Map")
				local num = math.random(1, 6)
				if map then
					local ghost = Instance.new("Part")
					ghost.Size = Vector3.new(2, 5, 1)
					ghost.CFrame = CFrame.new((num - 101) * 10 - 25, 3, -40)
					ghost.Anchored = true
					ghost.CanCollide = false
					ghost.Color = Color3.fromRGB(10, 10, 12)
					ghost.Transparency = 0.4
					ghost.Name = "Hallucination"
					ghost.Parent = map
					task.delay(6, function() ghost:Destroy() end)
				end
			end
		else
			whisper.Volume = 0
			local cam = workspace.CurrentCamera
			if cam and cam.FieldOfView ~= 70 then
				cam.FieldOfView = 70
			end
		end
	end
end)
</ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX23"><Properties><string name="Name">StarterGui</string><bool name="ResetPlayerGuiOnSpawn">false</bool></Properties></Item><Item class="SoundService" referent="RBX24"><Properties><string name="Name">SoundService</string><token name="AmbientReverb">0</token></Properties></Item><Item class="Lighting" referent="RBX25"><Properties><string name="Name">Lighting</string><Color3 name="Ambient"><R>0.03</R><G>0.03</G><B>0.05</B></Color3><Color3 name="OutdoorAmbient"><R>0.07</R><G>0.09</G><B>0.13</B></Color3><float name="Brightness">0.6</float><float name="ClockTime">0</float><bool name="GlobalShadows">true</bool><float name="ExposureCompensation">0.1</float><Color3 name="FogColor"><R>0.05</R><G>0.06</G><B>0.09</B></Color3><float name="FogStart">40</float><float name="FogEnd">320</float></Properties><Item class="Atmosphere" referent="RBX26"><Properties><string name="Name">Atmosphere</string><float name="Density">0.42</float><float name="Offset">0.25</float><float name="Haze">2</float><float name="Glare">0</float><Color3 name="Color"><R>0.47</R><G>0.49</G><B>0.53</B></Color3><Color3 name="Decay"><R>0.2</R><G>0.2</G><B>0.25</B></Color3></Properties></Item></Item><Item class="Workspace" referent="RBX27"><Properties><string name="Name">Workspace</string></Properties></Item></roblox>