<roblox xmlns:xmime="http://schemas.microsoft.com/2003/10/Serialization/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX2"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source">local Config = {}

Config.AdminUserId = 6157267885

Config.StartMoney = 50
Config.CurrentYear = 2025
Config.MaxDesks = 3
Config.DeskPrices = { [2] = 150, [3] = 300 }
Config.CoffeePrice = 5
Config.CoffeeSanity = 30
Config.WarmerSanity = 50
Config.WarmerMinutes = 20
Config.HuntSeconds = 60
Config.MonsterSpeed = 16
Config.DoorBreakSeconds = 10
Config.BarricadeBonus = 5
Config.RoomNumbers = { 101, 102, 103, 104, 105, 106 }
Config.CleanBonusMoney = 10
Config.CleanBonusRep = 5
Config.OverstayChance = 0.25
Config.AngryReturnChance = 0.35
Config.NextGuestDelay = 5

Config.AdmitHumanMoney = 20
Config.AdmitHumanRep = 10
Config.DenyHumanMoney = -10
Config.DenyHumanRep = -15
Config.DenyMonsterMoney = 10
Config.DenyMonsterRep = 10

Config.Nights = {
	{ guests = 5, monsters = 1, newRules = 0, lieSkill = 1, flicker = false, hints = true },
	{ guests = 6, monsters = 2, newRules = 1, lieSkill = 1, flicker = false, hints = false, cameraOnly = true },
	{ guests = 7, monsters = 2, newRules = 2, lieSkill = 2, flicker = false, hints = false },
	{ guests = 8, monsters = 3, newRules = 1, lieSkill = 2, flicker = true, hints = false },
	{ guests = 10, monsters = 4, newRules = 2, lieSkill = 3, flicker = true, hints = false },
}

Config.Tells = {
	{ id = "ExtraFinger", cat = "Hands", label = "Six fingers on one hand" },
	{ id = "LongHands", cat = "Hands", label = "Hands are too long" },
	{ id = "BlackEyes", cat = "Face", label = "Solid black eyes" },
	{ id = "NoReflection", cat = "Face", label = "No reflection in the mirror" },
	{ id = "TooManyTeeth", cat = "Face", label = "Too many teeth" },
	{ id = "PaleSkin", cat = "Face", label = "Skin too pale" },
	{ id = "ShadowWrong", cat = "Face", label = "Shadow the wrong shape" },
	{ id = "WrongYear", cat = "Papers", label = "Said the wrong year" },
	{ id = "NameMismatch", cat = "Papers", label = "Name does not match the ID" },
	{ id = "NoCamera", cat = "Camera", label = "Does not appear on camera" },
	{ id = "DistortedCam", cat = "Camera", label = "Looks wrong on camera" },
}

Config.Rules = {
	"Count the fingers. A guest with six fingers on one hand is not human. (Hands)",
	"Look at the eyes. Solid black eyes are not human. (Face)",
	"Answers must match the ID. A guest who says the wrong year, or whose name does not match the ID card, is not human. (Papers)",
	"Watch the cameras. Some things do not appear on camera at all. (Camera)",
	"Look closely at the face. Too many teeth, skin too pale, or a shadow with the wrong shape is not human. (Face)",
	"Look at the hands. Hands that are too long are not hands. (Hands)",
	"THE 2-CATEGORY RULE: a guest is a confirmed monster only when you find tells in TWO different categories. One tell alone is only suspicion. Keep investigating.",
	"Some guests show nothing at all. If the cameras show nobody standing at the desk, turn that guest away. (Camera)",
	"When you are tired you cannot trust your eyes. Drink coffee, and trust the handbook instead. (Sanity)",
}

Config.Questions = {
	{ id = "from", text = "Where are you traveling from?" },
	{ id = "id", text = "Can I see your ID?" },
	{ id = "year", text = "What year is it?" },
}

Config.ExtraQuestions = {
	{ id = "job", text = "What is your job?" },
	{ id = "stay", text = "How long are you staying?" },
}

Config.FirstNames = {
	"Harold", "Vera", "Dale", "Ruth", "Clyde", "Mabel", "Otis", "June",
	"Roy", "Edna", "Walt", "Ida", "Gus", "Pearl", "Hank", "Elsie",
	"Cecil", "Opal", "Vern", "Hazel", "Amos", "Lois", "Dewey", "Fay",
}

Config.LastNames = {
	"Carter", "Whitlock", "Mason", "Dell", "Hargrove", "Pike", "Slade", "Fenwick",
	"Boone", "Crane", "Vance", "Holt", "Marsh", "Keller", "Doyle", "Reyes",
}

Config.Cities = {
	"Ridgeville", "Cedar Falls", "Milton", "Ashgrove", "Fairview", "Kettle Creek",
	"Dry Gulch", "Larkspur", "Halloway", "Stonebridge",
}

Config.Jobs = {
	"Electrician", "Trucker", "Nurse", "Salesman", "Mechanic", "Teacher",
	"Line cook", "Mail carrier", "Welder", "Store clerk",
}

Config.Stays = { "1 night", "2 nights", "3 nights", "the weekend", "just tonight" }

Config.CreepyLines = {
	"From where the road ends.",
	"You would not know it.",
	"From a long way back.",
	"Down past the tree line.",
	"I have always been close by.",
	"Does it matter?",
}

Config.CreepyJobs = {
	"I fix things.",
	"I visit people.",
	"Night work.",
	"It is hard to explain.",
	"I was asked not to say.",
}

Config.CreepyStays = {
	"Until it is over.",
	"Just tonight. Maybe forever.",
	"As long as you will have me.",
	"I will know when to leave.",
}

Config.Objectives = {
	"Check every guest. Survive until morning.",
	"The cameras are your only chance against the ones with no tells.",
	"Monsters lie better now. Trust two categories, not one.",
	"Power flickers tonight. Do not panic when the lights die.",
	"The last night. Everything at once. Survive until dawn.",
}

return Config
</ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX12"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">AdminServer</string><ProtectedString name="Source">-- AdminServer: erdl18 (UserId 6157267885) ONLY. The server re-checks the UserId
-- on EVERY admin action. Nothing else can trigger any of this.
local Players = game:GetService("Players")

local AdminServer = {}
local ctx, Config, Remotes, State, Map, Controls

local ADMIN_ID = 6157267885

local function isAdmin(player)
	return player ~= nil and player.UserId == ADMIN_ID
end

local function sendLog(player)
	Remotes.AdminData:FireClient(player, { kind = "log", entries = State.log })
end

local function sendPlayers(player)
	local list = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		table.insert(list, {
			name = pl.Name,
			userId = pl.UserId,
			money = State.money,
			rep = State.rep,
			sanity = ctx.Sanity.Get(pl),
			desk = Controls.playerDesks[pl],
		})
	end
	Remotes.AdminData:FireClient(player, { kind = "players", list = list })
end

local function findPlayer(name)
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Name:lower() == tostring(name):lower() then return pl end
	end
	return nil
end

local actions

actions = {
	-- GAME
	start = function()
		if State.phase == "Lobby" or State.phase == "GameOver" then
			Controls.startNight(math.max(1, State.night))
		end
	end,
	pause = function()
		State.toggles.paused = not State.toggles.paused
		Controls.log("Admin paused=" .. tostring(State.toggles.paused))
	end,
	endGame = function()
		State.phase = "Lobby"
		ctx.Hunt.Stop()
		ctx.sendState()
	end,
	setNight = function(data)
		local n = math.clamp(math.floor(tonumber(data) or 1), 1, 5)
		ctx.Hunt.Stop()
		Controls.startNight(n)
	end,
	nextNight = function()
		if State.phase == "Dawn" or State.phase == "Shop" then
			if State.night &gt;= 5 then
				State.phase = "Win"
				Remotes.EndScreen:FireAllClients(true, { money = State.money, stars = Controls.stars() })
			else
				Controls.startNight(State.night + 1)
			end
		end
	end,
	restartNight = function()
		State.money = State.snapshotMoney
		State.rep = State.snapshotRep
		Controls.startNight(State.night)
	end,
	skipDawn = function()
		if State.phase == "Dawn" or State.phase == "Shop" then
			actions.nextNight()
		end
	end,
	win = function()
		State.phase = "Win"
		Remotes.EndScreen:FireAllClients(true, { money = State.money, stars = Controls.stars() })
	end,
	lose = function()
		ctx.Hunt.lose()
	end,
	reset = function()
		ctx.Hunt.Stop()
		State.phase = "Lobby"
		State.night = 1
		State.money = Config.StartMoney
		State.rep = 0
		State.desksBought = 1
		ctx.Controls.setDeskBought(2, false)
		ctx.Controls.setDeskBought(3, false)
		State.rulesRevealed = 3
		Controls.resetRooms()
		ctx.Sanity.RefillAll()
		ctx.sendState()
		Controls.startNight(1)
	end,

	-- GUESTS
	spawnGuest = function()
		Controls.spawnGuest()
	end,
	forceHuman = function() State.forceNext = "human" end,
	forceMonster = function() State.forceNext = "monster" end,
	clearForce = function() State.forceNext = nil end,
	setTells = function(data)
		local guest = Controls.getGuest(data.guestId)
		if guest then
			guest.tells = data.tells or {}
			Controls.log("Admin set tells on guest " .. data.guestId)
		end
	end,
	removeCurrent = function()
		for id, g in pairs(State.activeGuests) do
			if g.model then g.model:Destroy() end
			State.activeGuests[id] = nil
			Remotes.GuestUpdate:FireAllClients({ desk = g.desk, id = id, present = false })
		end
	end,
	clearQueue = function()
		State.queueLeft = 0
		Controls.removeCurrent()
		Controls.log("Guest queue cleared")
	end,
	setQuotaGuests = function(data) State.quotaGuests = math.max(1, math.floor(tonumber(data) or 5)) end,
	setQuotaMonsters = function(data) State.quotaMonsters = math.max(0, math.floor(tonumber(data) or 1)) end,

	-- ECONOMY
	setMoney = function(data)
		State.money = math.floor(tonumber(data) or 0)
		ctx.sendState()
	end,
	giveMoney = function(data)
		State.money = State.money + math.floor(tonumber(data) or 0)
		ctx.sendState()
	end,
	setRep = function(data)
		State.rep = tonumber(data) or 0
		ctx.sendState()
	end,
	setSanity = function(data)
		local pl = findPlayer(data.player)
		if pl then ctx.Sanity.Set(pl, tonumber(data.value) or 100) end
	end,
	refillSanity = function() ctx.Sanity.RefillAll() end,
	setCoffeePrice = function(data)
		State.coffeePrice = math.max(0, math.floor(tonumber(data) or 5))
		ctx.sendState()
	end,

	-- DESKS
	giveDesk = function(data)
		local slot = math.clamp(math.floor(tonumber(data) or 2), 2, 3)
		if slot &gt; State.desksBought then
			State.desksBought = slot
			Controls.setDeskBought(slot, true)
			ctx.sendState()
		end
	end,
	removeDesk = function(data)
		local slot = math.clamp(math.floor(tonumber(data) or 3), 2, 3)
		if slot &gt;= State.desksBought then
			State.desksBought = slot - 1
			Controls.setDeskBought(slot, false)
			ctx.sendState()
		end
	end,
	unlockAllDesks = function()
		State.desksBought = 3
		Controls.setDeskBought(2, true)
		Controls.setDeskBought(3, true)
		ctx.sendState()
	end,
	setDeskPrice = function(data)
		local slot = tonumber(data.slot)
		local price = math.max(0, math.floor(tonumber(data.price) or 150))
		if slot == 2 or slot == 3 then
			Config.DeskPrices[slot] = price
			ctx.sendState()
		end
	end,

	-- HUNT
	startHunt = function()
		local monsters = {}
		for _, g in pairs(State.activeGuests) do
			if g.isMonster then table.insert(monsters, g) end
		end
		if #monsters == 0 then
			monsters = State.admittedMonsters
		end
		if #monsters == 0 then
			Controls.log("No monsters to hunt; spawn one first")
			return
		end
		task.spawn(function() ctx.Hunt.Run(ctx, monsters) end)
	end,
	stopHunt = function() ctx.Hunt.Stop() end,
	spawnMonster = function()
		State.forceNext = "monster"
		Controls.spawnGuest()
	end,
	removeMonsters = function()
		for _, g in pairs(State.activeGuests) do
			if g.isMonster and g.model then g.model:Destroy() end
		end
		for _, m in ipairs(State.admittedMonsters) do
			if m.model and m.model.Parent then m.model:Destroy() end
		end
		State.admittedMonsters = {}
	end,
	setHuntTimer = function(data) State.huntTime = math.max(5, math.floor(tonumber(data) or 60)) end,
	setMonsterSpeed = function(data) State.monsterSpeed = math.clamp(tonumber(data) or 16, 4, 40) end,

	-- MAP / WEATHER
	rain = function(data)
		ctx.VFX.SetRain(data.on, data.intensity)
	end,
	fog = function(data) ctx.VFX.SetFog(data == true or data == "on") end,
	sign = function(data)
		ctx.VFX.SetSign(data.on, data.color)
	end,
	lights = function(data) ctx.VFX.SetLights(data == true or data == "on") end,
	flicker = function()
		task.spawn(function() ctx.VFX.PowerFlicker(10) end)
	end,
	lockDoors = function()
		for num in pairs(Map.Doors) do Controls.setDoorLock(num, true) Controls.setDoor(num, false) end
	end,
	unlockDoors = function()
		for num in pairs(Map.Doors) do Controls.setDoorLock(num, false) end
	end,
	openDoors = function()
		for num in pairs(Map.Doors) do Controls.setDoor(num, true) end
	end,
	closeDoors = function()
		for num in pairs(Map.Doors) do Controls.setDoor(num, false) end
	end,
	teleport = function(data)
		local pl = findPlayer(data.player)
		if not pl then return end
		local char = pl.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local where = data.where
		if where == "lobby" then
			hrp.CFrame = CFrame.new(0, 4, 4)
		elseif where == "me" then
			local me = Players:GetPlayerByUserId(ADMIN_ID)
			local mhrp = me and me.Character and me.Character:FindFirstChild("HumanoidRootPart")
			if mhrp then hrp.CFrame = mhrp.CFrame * CFrame.new(2, 0, 2) end
		elseif where == "security" then
			hrp.CFrame = CFrame.new(-26.5, 4, 12.5)
		else
			local num = tonumber(where)
			if num and num &gt;= 101 and num &lt;= 106 then
				hrp.CFrame = CFrame.new((num - 101) * 10 - 25, 4, -40)
			end
		end
	end,

	-- PLAYERS
	heal = function(data)
		local pl = findPlayer(data)
		if pl then
			local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.Health = hum.MaxHealth end
			local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
			if hrp then hrp.Anchored = false end
			Remotes.Downed:FireClient(pl, false)
			ctx.Sanity.Set(pl, 100)
		end
	end,
	kick = function(data)
		local pl = findPlayer(data)
		if pl then pl:Kick("Removed by admin.") end
	end,

	-- TOGGLES
	toggle = function(data)
		local name = tostring(data)
		if State.toggles[name] ~= nil then
			State.toggles[name] = not State.toggles[name]
			Controls.log("Toggle " .. name .. " = " .. tostring(State.toggles[name]))
			ctx.sendState()
		end
	end,

	-- LOG
	getLog = function(player) sendLog(player) end,
	listPlayers = function(player) sendPlayers(player) end,

	-- ALIASES used by the panel buttons
	rainOn = function() ctx.VFX.SetRain(true, 1) end,
	rainOff = function() ctx.VFX.SetRain(false) end,
	rainIntensity = function(data) ctx.VFX.SetRain(true, math.clamp(tonumber(data) or 1, 0.1, 3)) end,
	fogOn = function() ctx.VFX.SetFog(true) end,
	fogOff = function() ctx.VFX.SetFog(false) end,
	signOn = function() ctx.VFX.SetSign(true) end,
	signOff = function() ctx.VFX.SetSign(false) end,
	signColor = function(data) ctx.VFX.SetSign(true, data) end,
	lightsOn = function() ctx.VFX.SetLights(true) end,
	lightsOff = function() ctx.VFX.SetLights(false) end,
	teleportRoom = function(data) actions.teleport(data) end,
}

function AdminServer.Init(c)
	ctx = c
	Config = c.Config
	Remotes = c.Remotes
	State = c.State
	Map = c.Map
	Controls = c.Controls

	Remotes.Admin.OnServerEvent:Connect(function(player, action, data)
		if not isAdmin(player) then
			Controls.log("REJECTED admin action from " .. player.Name .. " (UserId " .. player.UserId .. ")")
			return
		end
		local fn = actions[action]
		if not fn then return end
		local ok, err = pcall(fn, data, player)
		if not ok then
			Controls.log("Admin action error (" .. tostring(action) .. "): " .. tostring(err))
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		if isAdmin(player) then
			player:SetAttribute("NSM_Admin", true)
			player.Chatted:Connect(function(msg)
				if msg == ":admin" then
					Remotes.AdminData:FireClient(player, { kind = "open" })
				end
			end)
		end
	end)
end

function AdminServer.IsAdmin(player)
	return isAdmin(player)
end

return AdminServer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">ChoresServer</string><ProtectedString name="Source">-- ChoresServer: morning chores — messy rooms (eaten guests) and overstayers.
local ChoresServer = {}
local ctx, Config, Remotes, State, Map
local chores = {}

local ARGUMENTS = {
	"I paid for another night!",
	"Just five more minutes...",
	"Do you know who I am?",
}
local WRONG_REPLIES = {
	"Okay... sleep in, I guess.",
	"Take your time, sir.",
	"Fine, whatever you want.",
}
local GIVE_UP = {
	"Ugh. FINE. I am going.",
	"Unbelievable service here...",
	"You have not heard the end of this.",
}

function ChoresServer.Init(c)
	ctx = c
	Config = c.Config
	Remotes = c.Remotes
	State = c.State
	Map = c.Map
end

local function buildMess(num)
	local x = (num - 101) * 10 - 25
	local folder = Instance.new("Folder")
	folder.Name = "Mess" .. num
	folder.Parent = Map
	local function mp(pos, size, color, rot)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = CFrame.new(pos) * CFrame.Angles(0, rot or 0, 0)
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.Parent = folder
		return p
	end
	mp(Vector3.new(x - 3, 0.6, -42), Vector3.new(1.6, 1.2, 1.2), Color3.fromRGB(120, 95, 60), 0.5)
	mp(Vector3.new(x - 1.5, 0.4, -44), Vector3.new(1.2, 0.8, 1), Color3.fromRGB(100, 80, 55), 1.2)
	mp(Vector3.new(x + 2.5, 0.35, -43.5), Vector3.new(1.4, 0.7, 1.4), Color3.fromRGB(110, 75, 50), 2)
	mp(Vector3.new(x + 1, 0.5, -45.5), Vector3.new(1.6, 1, 1.2), Color3.fromRGB(120, 40, 40), 0.9)
	mp(Vector3.new(x, 0.12, -41), Vector3.new(5, 0.05, 5), Color3.fromRGB(35, 20, 20))
	local stain = mp(Vector3.new(x - 2.5, 0.13, -43.5), Vector3.new(3.4, 0.06, 3.4), Color3.fromRGB(30, 15, 15))
	stain.Shape = Enum.PartType.Cylinder
	stain.Size = Vector3.new(0.06, 3.4, 3.4)
	stain.CFrame = CFrame.new(x - 2.5, 0.13, -43.5) * CFrame.Angles(0, 0, math.rad(90))
	local bed = Map:FindFirstChild("Bed" .. num, true)
	if bed then bed.CFrame = bed.CFrame * CFrame.Angles(0, 0, math.rad(8)) end
	local promptHolder = mp(Vector3.new(x, 2, -41), Vector3.new(0.4, 0.4, 0.4), Color3.fromRGB(255, 220, 120))
	promptHolder.Transparency = 1
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Clean the room"
	prompt.ObjectText = "Room " .. num
	prompt.HoldDuration = 5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = promptHolder
	prompt.Triggered:Connect(function(player)
		folder:Destroy()
		Map.Rooms[num].state = "clean"
		for _, ch in ipairs(chores) do
			if ch.room == num and ch.kind == "messy" then ch.done = true end
		end
		ctx.notify(nil, "Room " .. num .. " cleaned.", "good")
		ctx.VFX.Play("water", workspace, 0.6)
		ChoresServer.CheckAllDone()
		ctx.sendState()
	end)
	return folder
end

local function buildOverstayer(guest, num)
	local model = guest.model
	if not model or not model.Parent then return end
	local head = model:FindFirstChild("Head")
	if not head then return end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Tell them to leave"
	prompt.ObjectText = "Room " .. num
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = head
	prompt.Triggered:Connect(function(player)
		Remotes.ChoreDialog:FireClient(player, num, ARGUMENTS[math.random(#ARGUMENTS)])
	end)
	guest.overstayPrompt = prompt
end

function ChoresServer.HandleReply(player, num, choice)
	local r = Map.Rooms[num]
	if not r or r.state ~= "overstayer" or not r.occupant then return end
	if choice == 2 then
		local guest = r.occupant
		ctx.GuestGen.Say(guest, GIVE_UP[math.random(#GIVE_UP)])
		r.state = "cleaning"
		if guest.overstayPrompt then guest.overstayPrompt:Destroy() end
		task.spawn(function()
			task.wait(1.5)
			ctx.walkTo(guest.model, Vector3.new((num - 101) * 10 - 25, 3.5, -30), 15)
			ctx.walkTo(guest.model, Vector3.new(0, 3.5, -26), 20)
			ctx.walkTo(guest.model, Vector3.new(math.random(-8, 8), 3.5, 58), 25)
			if guest.model.Parent then guest.model:Destroy() end
			r.state = "clean"
			r.occupant = nil
			for _, ch in ipairs(chores) do
				if ch.room == num and ch.kind == "overstayer" then ch.done = true end
			end
			ctx.notify(nil, "Room " .. num .. " is free again.", "good")
			ChoresServer.CheckAllDone()
			ctx.sendState()
		end)
	else
		if r.occupant then
			ctx.GuestGen.Say(r.occupant, WRONG_REPLIES[math.random(#WRONG_REPLIES)] .. " (" .. ARGUMENTS[math.random(#ARGUMENTS)] .. ")")
		end
	end
end

function ChoresServer.CheckAllDone()
	for _, ch in ipairs(chores) do
		if not ch.done then return end
	end
	if #chores &gt; 0 and not State.choresDone then
		State.choresDone = true
		ctx.Controls.applyMoney(Config.CleanBonusMoney)
		ctx.Controls.applyRep(Config.CleanBonusRep)
		ctx.notify(nil, "ALL CHORES DONE! Clean motel bonus: +$" .. Config.CleanBonusMoney .. " and +" .. Config.CleanBonusRep .. " reputation.", "good")
		ctx.Controls.log("All morning chores completed")
		ctx.sendState()
	end
end

function ChoresServer.Process(c, monsters, humans)
	chores = {}
	State.choresDone = false
	local eaten = {}
	for _, monster in ipairs(monsters) do
		local candidates = {}
		for _, h in ipairs(humans) do
			if not eaten[h] and h.model and h.model.Parent and h.roomNumber then
				table.insert(candidates, h)
			end
		end
		if #candidates &gt; 0 then
			local victim = candidates[math.random(#candidates)]
			eaten[victim] = true
			local num = victim.roomNumber
			if victim.model.Parent then victim.model:Destroy() end
			Map.Rooms[num].state = "messy"
			Map.Rooms[num].occupant = nil
			buildMess(num)
			table.insert(chores, { room = num, kind = "messy", done = false })
			ctx.Controls.log("Monster from Room " .. tostring(monster.roomNumber) .. " ate the guest in Room " .. num)
		end
	end
	for _, h in ipairs(humans) do
		if not eaten[h] and h.model and h.model.Parent and h.roomNumber and Map.Rooms[h.roomNumber].state == "occupied" then
			if math.random() &lt; Config.OverstayChance then
				Map.Rooms[h.roomNumber].state = "overstayer"
				buildOverstayer(h, h.roomNumber)
				table.insert(chores, { room = h.roomNumber, kind = "overstayer", done = false })
				ctx.Controls.log("Guest in Room " .. h.roomNumber .. " refuses to check out")
			else
				local num = h.roomNumber
				Map.Rooms[num].state = "cleaning"
				local g = h
				task.spawn(function()
					ctx.walkTo(g.model, Vector3.new((num - 101) * 10 - 25, 3.5, -30), 15)
					ctx.walkTo(g.model, Vector3.new(0, 3.5, -26), 20)
					ctx.walkTo(g.model, Vector3.new(math.random(-8, 8), 3.5, 58), 25)
					if g.model.Parent then g.model:Destroy() end
					if Map.Rooms[num].state == "cleaning" then Map.Rooms[num].state = "clean" end
					Map.Rooms[num].occupant = nil
					ctx.sendState()
				end)
			end
		end
	end
	return chores
end

function ChoresServer.GetChoreList()
	local list = {}
	for _, ch in ipairs(chores) do
		table.insert(list, { room = ch.room, kind = ch.kind, done = ch.done })
	end
	return list
end

return ChoresServer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">GuestGen</string><ProtectedString name="Source">-- GuestGen v2: guest NPCs built as Motor6D rigs with a procedural walk cycle,
-- detailed faces and clothing, and the physical monster tells.
local RunService = game:GetService("RunService")

local GuestGen = {}

local rigs = {}

RunService.Heartbeat:Connect(function(dt)
	for model, rig in pairs(rigs) do
		if not model.Parent then
			rigs[model] = nil
		else
			local moving = rig.humanoid.Parent ~= nil and rig.humanoid.MoveDirection.Magnitude &gt; 0.05
			if moving then
				rig.phase = (rig.phase or 0) + dt * 9
				local s = math.sin(rig.phase)
				rig.lShoulder.C0 = rig.baseLS * CFrame.Angles(s * 0.5, 0, 0.06)
				rig.rShoulder.C0 = rig.baseRS * CFrame.Angles(-s * 0.5, 0, -0.06)
				rig.lHip.C0 = rig.baseLH * CFrame.Angles(-s * 0.45, 0, 0)
				rig.rHip.C0 = rig.baseRH * CFrame.Angles(s * 0.45, 0, 0)
			else
				rig.lShoulder.C0 = rig.lShoulder.C0:Lerp(rig.baseLS, 0.15)
				rig.rShoulder.C0 = rig.rShoulder.C0:Lerp(rig.baseRS, 0.15)
				rig.lHip.C0 = rig.lHip.C0:Lerp(rig.baseLH, 0.15)
				rig.rHip.C0 = rig.rHip.C0:Lerp(rig.baseRH, 0.15)
			end
		end
	end
end)

local function part(model, size, cf, color, material)
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = false
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function weldTo(base, p)
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
end

local function motor(model, part0, part1, c0, c1, name)
	local m = Instance.new("Motor6D")
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1
	m.Name = name
	m.Parent = part0
	return m
end

local function buildFace(model, head, skin, isMonster, has)
	if isMonster and has("BlackEyes") then
		for _, ex in ipairs({ -0.3, 0.3 }) do
			local e = part(model, Vector3.new(0.42, 0.44, 0.08), head.CFrame * CFrame.new(ex, 0.12, -0.62), Color3.fromRGB(8, 8, 8))
			e.Name = "Eye"
			weldTo(head, e)
		end
	else
		for _, ex in ipairs({ -0.3, 0.3 }) do
			local e = part(model, Vector3.new(0.3, 0.26, 0.06), head.CFrame * CFrame.new(ex, 0.14, -0.62), Color3.fromRGB(245, 245, 245))
			e.Name = "Eye"
			weldTo(head, e)
			local pu = part(model, Vector3.new(0.12, 0.12, 0.05), head.CFrame * CFrame.new(ex, 0.14, -0.66), Color3.fromRGB(20, 20, 24))
			pu.Name = "Pupil"
			weldTo(head, pu)
		end
	end
	local nose = part(model, Vector3.new(0.18, 0.26, 0.16), head.CFrame * CFrame.new(0, -0.06, -0.66), skin)
	weldTo(head, nose)
	if isMonster and has("TooManyTeeth") then
		for i = 1, 9 do
			local t = part(model, Vector3.new(0.12, 0.24, 0.06), head.CFrame * CFrame.new(-0.48 + (i - 1) * 0.12, -0.42, -0.62), Color3.fromRGB(250, 250, 240))
			t.Name = "Tooth"
			weldTo(head, t)
		end
	else
		local mouth = part(model, Vector3.new(0.5, 0.1, 0.06), head.CFrame * CFrame.new(0, -0.42, -0.62), Color3.fromRGB(96, 58, 58))
		weldTo(head, mouth)
	end
end

local function buildHat(model, head, isMonster)
	if isMonster then return end
	local roll = math.random()
	if roll &lt; 0.22 then
		local dark = Color3.fromRGB(32, 30, 32)
		local brim = part(model, Vector3.new(1.9, 0.1, 1.9), head.CFrame * CFrame.new(0, 0.58, 0), dark, Enum.Material.Fabric)
		weldTo(head, brim)
		local crown = part(model, Vector3.new(1.1, 0.5, 1.1), head.CFrame * CFrame.new(0, 0.86, 0), dark, Enum.Material.Fabric)
		weldTo(head, crown)
	elseif roll &lt; 0.65 then
		local hairColors = { Color3.fromRGB(42, 32, 24), Color3.fromRGB(22, 22, 22), Color3.fromRGB(92, 72, 46), Color3.fromRGB(122, 112, 102) }
		local hair = part(model, Vector3.new(1.36, 0.38, 1.36), head.CFrame * CFrame.new(0, 0.52, 0), hairColors[math.random(#hairColors)], Enum.Material.Fabric)
		weldTo(head, hair)
	end
end

local function buildClothes(model, torso)
	local shirt = part(model, Vector3.new(1.2, 1.7, 0.12), torso.CFrame * CFrame.new(0, 0.05, -0.47), Color3.fromRGB(224, 221, 208))
	weldTo(torso, shirt)
	local tie = part(model, Vector3.new(0.3, 0.85, 0.08), torso.CFrame * CFrame.new(0, 0.38, -0.55), Color3.fromRGB(118, 30, 36))
	weldTo(torso, tie)
	local belt = part(model, Vector3.new(2.06, 0.28, 1.06), torso.CFrame * CFrame.new(0, -0.88, 0), Color3.fromRGB(26, 22, 20))
	weldTo(torso, belt)
end

local function buildArm(model, torso, side, armLen, suit, skin, sixFingers)
	local c0 = CFrame.new(side * 1.425, 0.75, 0)
	local c1 = CFrame.new(0, -armLen / 2 + 0.3, 0)
	local armCF = torso.CFrame * c0 * c1
	local arm = part(model, Vector3.new(0.85, armLen, 0.85), armCF, suit)
	arm.Name = "Arm"
	local m = motor(model, torso, arm, c0, c1, "Shoulder")
	local hand = part(model, Vector3.new(0.8, 0.55, 0.8), armCF * CFrame.new(0, -armLen / 2 - 0.2, 0), skin)
	weldTo(arm, hand)
	local count = sixFingers and 6 or 5
	for i = 1, count do
		local off = -0.3 + (i - 1) * (0.6 / (count - 1))
		local f = part(model, Vector3.new(0.13, 0.42, 0.13), hand.CFrame * CFrame.new(off, -0.42, 0), skin)
		f.Name = "Finger"
		weldTo(hand, f)
	end
	return m
end

local function buildLeg(model, torso, side)
	local c0 = CFrame.new(side * 0.55, -1, 0)
	local c1 = CFrame.new(0, -1, 0)
	local legCF = torso.CFrame * c0 * c1
	local leg = part(model, Vector3.new(0.85, 2, 0.85), legCF, Color3.fromRGB(36, 36, 42))
	leg.Name = "Leg"
	local m = motor(model, torso, leg, c0, c1, "Hip")
	local shoe = part(model, Vector3.new(0.9, 0.3, 1.15), legCF * CFrame.new(0, -1.05, -0.12), Color3.fromRGB(20, 20, 22))
	weldTo(leg, shoe)
	return m
end

-- spec = { isMonster, tells (array of tell ids), angry, cameraApp, walkSpeed, desk, spawnPos, idFrom }
function GuestGen.Create(ctx, spec)
	local Config = ctx.Config
	local isMonster = spec.isMonster
	local tells = spec.tells or {}
	local has = function(id)
		for _, t in ipairs(tells) do
			if t == id then return true end
		end
		return false
	end

	local first = Config.FirstNames[math.random(#Config.FirstNames)]
	local last = Config.LastNames[math.random(#Config.LastNames)]
	local idName = first .. " " .. last
	local spokenName = idName
	if isMonster and has("NameMismatch") then
		local other = Config.FirstNames[math.random(#Config.FirstNames)] .. " " .. Config.LastNames[math.random(#Config.LastNames)]
		if other == idName then other = other .. "s" end
		spokenName = other
	end

	local pale = isMonster and has("PaleSkin")
	local skin = pale and Color3.fromRGB(216, 214, 208) or Color3.fromRGB(math.random(150, 210), math.random(120, 165), math.random(100, 140))
	local suit = Color3.fromRGB(math.random(28, 60), math.random(28, 60), math.random(34, 70))

	local model = Instance.new("Model")
	model.Name = "Guest"

	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.Transparency = 1
	hrp.CanCollide = true
	hrp.CFrame = CFrame.new(spec.spawnPos or Vector3.new(0, 3.5, 55))
	hrp.Parent = model

	local torso = part(model, Vector3.new(2, 2, 1), hrp.CFrame, suit)
	torso.Name = "Torso"
	motor(model, hrp, torso, CFrame.new(), CFrame.new(), "RootJoint")

	local head = part(model, Vector3.new(1.3, 1.3, 1.3), hrp.CFrame * CFrame.new(0, 1.8, 0), skin)
	head.Name = "Head"
	motor(model, torso, head, CFrame.new(0, 1.15, 0), CFrame.new(0, -0.65, 0), "Neck")

	buildFace(model, head, skin, isMonster, has)
	buildHat(model, head, isMonster)
	buildClothes(model, torso)

	local armLen = (isMonster and has("LongHands")) and 3.2 or 2
	local sixFingers = isMonster and has("ExtraFinger")
	local lShoulder = buildArm(model, torso, -1, armLen, suit, skin, sixFingers)
	local rShoulder = buildArm(model, torso, 1, armLen, suit, skin, sixFingers)
	local lHip = buildLeg(model, torso, -1)
	local rHip = buildLeg(model, torso, 1)

	if isMonster and has("ShadowWrong") then
		local sh = part(model, Vector3.new(4.5, 0.06, 1.2), hrp.CFrame * CFrame.new(0.8, -2.97, 0.5) * CFrame.Angles(0, math.rad(35), 0), Color3.fromRGB(10, 10, 12))
		sh.Name = "Shadow"
		weldTo(hrp, sh)
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.WalkSpeed = spec.walkSpeed or 16
	humanoid.HipHeight = 2.2
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = model

	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 22
	cd.Parent = head

	model.PrimaryPart = hrp

	rigs[model] = {
		humanoid = humanoid,
		lShoulder = lShoulder,
		rShoulder = rShoulder,
		lHip = lHip,
		rHip = rHip,
		baseLS = lShoulder.C0,
		baseRS = rShoulder.C0,
		baseLH = lHip.C0,
		baseRH = rHip.C0,
		phase = math.random() * 6,
	}

	local answers = {}
	local wrongYear = isMonster and has("WrongYear")
	local year = Config.CurrentYear
	if wrongYear then
		year = ({ 1974, 1953, 1888, 2024 - math.random(20, 60) })[math.random(4)]
		if year &gt;= Config.CurrentYear then year = 1966 end
	end
	local fromAnswer = spec.idFrom or Config.Cities[math.random(#Config.Cities)]
	if isMonster and math.random() &lt; 0.5 then
		fromAnswer = Config.CreepyLines[math.random(#Config.CreepyLines)]
	end
	answers.from = fromAnswer
	answers.year = tostring(year) .. "."
	if isMonster and math.random() &lt; 0.4 then
		answers.year = answers.year .. " Is that right?"
	end
	answers.job = Config.Jobs[math.random(#Config.Jobs)]
	if isMonster and math.random() &lt; 0.5 then
		answers.job = Config.CreepyJobs[math.random(#Config.CreepyJobs)]
	end
	answers.stay = Config.Stays[math.random(#Config.Stays)]
	if isMonster and math.random() &lt; 0.4 then
		answers.stay = Config.CreepyStays[math.random(#Config.CreepyStays)]
	end

	local guest = {
		id = tostring(math.random(100000, 999999)) .. tostring(os.clock() * 1000),
		desk = spec.desk,
		isMonster = isMonster,
		tells = tells,
		angry = spec.angry or false,
		cameraApp = spec.cameraApp or "normal",
		idCard = { name = idName, from = spec.idFrom or answers.from, job = answers.job, stay = answers.stay },
		spokenName = spokenName,
		answers = answers,
		walkSpeed = spec.walkSpeed or 16,
		model = model,
		roomNumber = nil,
	}

	model:SetAttribute("GuestId", guest.id)
	return guest
end

function GuestGen.Say(guest, text)
	local head = guest.model:FindFirstChild("Head")
	if not head then return end
	local old = head:FindFirstChild("GuestBubble")
	if old then old:Destroy() end
	local bb = Instance.new("BillboardGui")
	bb.Name = "GuestBubble"
	bb.Size = UDim2.new(0, 260, 0, 90)
	bb.StudsOffset = Vector3.new(0, 2.4, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 60
	bb.Parent = head
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	tl.BackgroundTransparency = 0.25
	tl.TextColor3 = Color3.fromRGB(240, 240, 240)
	tl.TextScaled = true
	tl.Font = Enum.Font.Gotham
	tl.TextWrapped = true
	tl.Text = text
	tl.Parent = bb
	task.delay(6, function()
		if bb.Parent then bb:Destroy() end
	end)
end

return GuestGen
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">HuntManager</string><ProtectedString name="Source">-- HuntManager: lockdown phase. Monsters chase, doors get broken, 60 seconds to dawn.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local HuntManager = {}
local ctx, Config, Remotes, State, Map
local running = false
local stopRequested = false
local downed = {}

local function isDowned(player)
	return downed[player] == true
end

function HuntManager.Init(c)
	ctx = c
	Config = c.Config
	Remotes = c.Remotes
	State = c.State
	Map = c.Map
end

function HuntManager.lose()
	if not running then return end
	running = false
	State.phase = "GameOver"
	ctx.VFX.Lockdown(false)
	Remotes.HuntState:FireAllClients(false, 0)
	Remotes.EndScreen:FireAllClients(false, { night = State.night })
	ctx.Controls.log("LOSE: all players caught on night " .. State.night)
end

local function downPlayer(player)
	if downed[player] then return end
	if State.toggles.god and player.UserId == Config.AdminUserId then return end
	downed[player] = true
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then hrp.Anchored = true end
	if hum then hum.WalkSpeed = 0 end
	Remotes.Downed:FireClient(player, true)
	ctx.VFX.Play("caught", workspace, 1)
	ctx.notify(nil, player.Name .. " was caught!", "bad")
	local alive = 0
	for _, pl in ipairs(Players:GetPlayers()) do
		if not downed[pl] then alive = alive + 1 end
	end
	if alive == 0 then
		HuntManager.lose()
	end
end

function HuntManager.Stop()
	if running then
		stopRequested = true
	end
end

local function dissolve(model)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			TweenService:Create(p, TweenInfo.new(1.5), { Transparency = 1 }):Play()
		end
	end
	Debris:AddItem(model, 2)
end

function HuntManager.Run(c, monsters)
	ctx = c
	running = true
	stopRequested = false
	downed = {}
	State.phase = "Hunt"
	ctx.sendState()

	ctx.VFX.Lockdown(true)
	ctx.VFX.Play("rumble", workspace, 1, 0.35, false)
	ctx.notify(nil, "LOCKDOWN — SOMETHING IS IN THE ROOMS", "bad")
	Remotes.HuntState:FireAllClients(true, State.huntTime)
	ctx.Controls.log("Hunt started: " .. #monsters .. " monster(s) loose")

	local hunters = {}
	for _, guest in ipairs(monsters) do
		local model = guest.model
		if model and model.Parent then
			local hum = model:FindFirstChildOfClass("Humanoid")
			local hrp = model:FindFirstChild("HumanoidRootPart")
			if hum and hrp then
				hum.WalkSpeed = State.monsterSpeed
				for _, p in ipairs(model:GetDescendants()) do
					if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
						if p.Name == "Eye" then
							p.Color = Color3.fromRGB(255, 30, 30)
						else
							p.Color = Color3.fromRGB(25, 22, 26)
						end
					end
				end
				local cd = model:FindFirstChildWhichIsA("ClickDetector", true)
				if cd then cd:Destroy() end
				hrp.CFrame = CFrame.new(guest.roomNumber and (guest.roomNumber - 101) * 10 - 25 or 0, 3.5, -30)
				hunters[model] = { hum = hum, hrp = hrp, lastPath = 0 }
				hrp.Touched:Connect(function(hit)
					local pl = Players:GetPlayerFromCharacter(hit.Parent)
					if pl and not isDowned(pl) then
						if State.toggles.god and pl.UserId == Config.AdminUserId then return end
						downPlayer(pl)
					end
				end)
			end
		end
	end

	local endTime = os.clock() + State.huntTime
	local lastTick = os.clock()

	while running and os.clock() &lt; endTime do
		task.wait(0.35)
		if stopRequested then break end
		if os.clock() - lastTick &gt;= 1 then
			lastTick = os.clock()
			Remotes.HuntState:FireAllClients(true, math.max(0, math.ceil(endTime - os.clock())))
			for _, pl in ipairs(Players:GetPlayers()) do
				ctx.Sanity.Drain(pl, 1, "hunt")
			end
		end
		for model, h in pairs(hunters) do
			if model.Parent then
				local target, bestDist = nil, math.huge
				for _, pl in ipairs(Players:GetPlayers()) do
					local char = pl.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if hrp and not isDowned(pl) then
						local dist = (hrp.Position - h.hrp.Position).Magnitude
						if dist &lt; bestDist then bestDist = dist target = hrp end
					end
				end
				if target then
					local pos = target.Position
					if pos.Z &lt; -34 then
						local roomNum = 100 + math.clamp(math.floor((pos.X + 30) / 10) + 1, 1, 6)
						local d = Map.Doors[roomNum]
						if d and not d.isOpen then
							local doorPos = d.closed.Position
							if (h.hrp.Position - doorPos).Magnitude &gt; 5 then
								h.hum:MoveTo(doorPos)
							elseif not d.breaking then
								d.breaking = true
								local breakTime = Config.DoorBreakSeconds + (d.barricaded and Config.BarricadeBonus or 0)
								ctx.notify(nil, "Something is breaking down the door of Room " .. roomNum .. "!", "bad")
								ctx.VFX.Play("rumble", d.part, 1, 0.5)
								task.spawn(function()
									task.wait(breakTime)
									if d.part.Parent then
										d.isOpen = true
										d.part.CanCollide = false
										d.part.Transparency = 0.8
										if d.barricaded and d.chair then
											d.chair.Transparency = 1
										end
										ctx.VFX.Play("breakDoor", d.part, 1)
										ctx.VFX.Shake(1)
									end
								end)
							end
						else
							if os.clock() - h.lastPath &gt; 1 then
								h.lastPath = os.clock()
								ctx.walkPathAsync(model, pos)
							end
						end
					elseif os.clock() - h.lastPath &gt; 1 then
						h.lastPath = os.clock()
						ctx.walkPathAsync(model, pos)
					end
				end
			end
		end
	end

	running = false
	if stopRequested then
		ctx.VFX.Lockdown(false)
		Remotes.HuntState:FireAllClients(false, 0)
		for model in pairs(hunters) do
			if model.Parent then model:Destroy() end
		end
		ctx.Controls.log("Hunt stopped by admin")
		return true
	end

	if State.phase == "GameOver" then return false end

	for model in pairs(hunters) do
		if model.Parent then dissolve(model) end
	end
	ctx.VFX.Lockdown(false)
	Remotes.HuntState:FireAllClients(false, 0)
	ctx.notify(nil, "DAWN — YOU SURVIVED THE NIGHT", "good")
	ctx.Controls.log("Hunt survived on night " .. State.night)
	return true
end

return HuntManager
</ProtectedString></Properties></Item><Item class="Script" referent="RBX7"><Properties><string name="Name">Main</string><ProtectedString name="Source">-- Main: game state machine, guest flow, decisions, consequences.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("GameConfig"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))
local GuestGen = require(script.Parent:WaitForChild("GuestGen"))
local VFXServer = require(script.Parent:WaitForChild("VFXServer"))
local SanityServer = require(script.Parent:WaitForChild("SanityServer"))
local HuntManager = require(script.Parent:WaitForChild("HuntManager"))
local ChoresServer = require(script.Parent:WaitForChild("ChoresServer"))
local ShopServer = require(script.Parent:WaitForChild("ShopServer"))
local AdminServer = require(script.Parent:WaitForChild("AdminServer"))

-- REMOTES
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
local remoteNames = {
	"StateUpdate", "Notify", "GuestUpdate", "Inspect", "InspectResult", "Ask", "Answer",
	"Decide", "Sanity", "Hallucinate", "Shake", "HuntState", "Dawn", "TitleCard",
	"ChoreDialog", "ChoreReply", "Admin", "AdminData", "QuickChat", "NextNight",
	"Shop", "PowerFlicker", "EndScreen", "Downed",
}
for _, name in ipairs(remoteNames) do
	local re = Instance.new("RemoteEvent")
	re.Name = name
	re.Parent = Remotes
end
Remotes.Parent = ReplicatedStorage

-- STATE
local State = {
	phase = "Lobby",
	night = 1,
	money = Config.StartMoney,
	rep = 0,
	queueLeft = 0,
	humansLeft = 0,
	monstersLeft = 0,
	rulesRevealed = 3,
	desksBought = 1,
	forceNext = nil,
	quotaGuests = nil,
	quotaMonsters = nil,
	warmerReadyAt = workspace:GetServerTimeNow() + Config.WarmerMinutes * 60,
	guestsPerNight = Config.Nights[1].guests,
	monstersPerNight = Config.Nights[1].monsters,
	snapshotMoney = Config.StartMoney,
	snapshotRep = 0,
	admittedMonsters = {},
	admittedHumans = {},
	activeGuests = {},
	guestsFolder = nil,
	correctCalls = 0,
	wrongCalls = 0,
	monstersCaught = 0,
	earnedTonight = 0,
	choresDone = false,
	toggles = { god = false, infiniteMoney = false, noSanityDrain = false, instantCoffee = false, freeze = false },
	huntTime = Config.HuntSeconds,
	monsterSpeed = Config.MonsterSpeed,
	log = {},
}

local function log(text)
	table.insert(State.log, os.date("%H:%M:%S") .. " " .. text)
	if #State.log &gt; 200 then table.remove(State.log, 1) end
	print("[NSM] " .. text)
end

local Map = MapBuilder.Build({ Config = Config })
local ctx = { Config = Config, Remotes = Remotes, State = State, Map = Map, log = log }
State.ctx = ctx

local Controls = {}
ctx.Controls = Controls

VFXServer.Init(ctx)
SanityServer.Init(ctx)
HuntManager.Init(ctx)
ChoresServer.Init(ctx)
ShopServer.Init(ctx)
AdminServer.Init(ctx)
ctx.Sanity = SanityServer
ctx.VFX = VFXServer
ctx.GuestGen = GuestGen
ctx.Hunt = HuntManager
ctx.Chores = ChoresServer
ctx.Shop = ShopServer

local function stars()
	if State.rep &lt;= 0 then return 1 end
	return math.clamp(math.ceil(State.rep / 20), 1, 5)
end

local function sendState()
	local rooms = {}
	for _, num in ipairs(Config.RoomNumbers) do
		table.insert(rooms, { num = num, state = Map.Rooms[num].state })
	end
	if Map.SignTexts and Map.SignTexts.vacancy then
		local hasClean = false
		for _, num2 in ipairs(Config.RoomNumbers) do
			if Map.Rooms[num2].state == "clean" and not Map.Rooms[num2].occupant then hasClean = true end
		end
		Map.SignTexts.vacancy.Text = hasClean and "VACANCY" or "NO VACANCY"
	end
	Remotes.StateUpdate:FireAllClients({
		money = State.money,
		rep = State.rep,
		stars = stars(),
		night = State.night,
		phase = State.phase,
		queueLeft = State.queueLeft,
		rules = State.rulesRevealed,
		ruleTexts = Config.Rules,
		desksBought = State.desksBought,
		deskPrices = Config.DeskPrices,
		coffeePrice = State.ctx.Sanity.GetCoffeePrice and State.ctx.Sanity.GetCoffeePrice() or Config.CoffeePrice,
		warmerReadyAt = State.warmerReadyAt,
		warmerMinutes = Config.WarmerMinutes,
		rooms = rooms,
		objective = Config.Objectives[State.night],
		hints = Config.Nights[State.night].hints,
	})
end
ctx.sendState = sendState
ctx.stars = stars

local function notify(player, text, kind)
	if player then
		Remotes.Notify:FireClient(player, text, kind)
	else
		Remotes.Notify:FireAllClients(text, kind)
	end
end
ctx.notify = notify

-- WALKING HELPERS (PathfindingService: guests route through doorways instead of walls)
local PathfindingService = game:GetService("PathfindingService")

local function makePath()
	return PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 4 })
end

local function arrived(hrp, pos)
	return (hrp.Position - pos).Magnitude &lt; 3.5
end

local function moveToWait(hum, position, seconds)
	local done = false
	local conn = hum.MoveToFinished:Connect(function()
		done = true
	end)
	hum:MoveTo(position)
	local t0 = os.clock()
	while not done and os.clock() - t0 &lt; (seconds or 2.5) do
		task.wait(0.1)
	end
	conn:Disconnect()
end

local function walkTo(model, pos, timeout)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	local deadline = os.clock() + (timeout or 25)
	local path = makePath()
	local ok = pcall(function()
		path:ComputeAsync(hrp.Position, pos)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		for _, wp in ipairs(path:GetWaypoints()) do
			if not hrp.Parent or os.clock() &gt; deadline then return end
			if arrived(hrp, pos) then return end
			moveToWait(hum, wp.Position, 2.5)
		end
	else
		hum:MoveTo(pos)
	end
	while hrp.Parent and os.clock() &lt; deadline do
		if arrived(hrp, pos) then return end
		hum:MoveTo(pos)
		task.wait(0.25)
	end
end
ctx.walkTo = walkTo

local walkTokens = {}
local function walkPathAsync(model, pos)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	if not model.Parent then
		walkTokens[model] = nil
		return
	end
	local token = (walkTokens[model] or 0) + 1
	walkTokens[model] = token
	task.spawn(function()
		local path = makePath()
		local ok = pcall(function()
			path:ComputeAsync(hrp.Position, pos)
		end)
		if walkTokens[model] ~= token or not model.Parent then return end
		if ok and path.Status == Enum.PathStatus.Success then
			for _, wp in ipairs(path:GetWaypoints()) do
				if walkTokens[model] ~= token or not model.Parent then return end
				moveToWait(hum, wp.Position, 2.5)
			end
		else
			hum:MoveTo(pos)
		end
	end)
end
ctx.walkPathAsync = walkPathAsync

-- DOORS
local function setDoor(num, open)
	local d = Map.Doors[num]
	if not d then return end
	d.isOpen = open
	if open then
		d.part.CFrame = d.openCF
		d.prompt.ActionText = "Close"
	else
		d.part.CFrame = d.closed
		d.prompt.ActionText = d.locked and "Locked" or "Open"
	end
end
ctx.setDoor = setDoor

local function setDoorLock(num, locked)
	local d = Map.Doors[num]
	if not d then return end
	d.locked = locked
	d.prompt.ActionText = d.isOpen and "Close" or (locked and "Locked" or "Open")
end
ctx.setDoorLock = setDoorLock

for num, d in pairs(Map.Doors) do
	d.prompt.Triggered:Connect(function(player)
		if d.breaking then return end
		if d.locked then
			notify(player, "This door is locked.", "info")
			return
		end
		setDoor(num, not d.isOpen)
		VFXServer.Play("lock", d.part, 0.6)
	end)
	d.barPrompt.Triggered:Connect(function(player)
		if State.phase ~= "Hunt" then return end
		if d.barricaded then return end
		d.barricaded = true
		d.chair.CFrame = d.closed * CFrame.new(0, 0, 1.6) * CFrame.Angles(0, math.rad(90), 0) * CFrame.new(0, 0.4, 0)
		d.chair.Anchored = true
		notify(player, "Door barricaded. The monster will take longer to break in.", "good")
	end)
end

Map.SecurityPrompt.Triggered:Connect(function()
	Map.SecurityDoorOpen = not Map.SecurityDoorOpen
	Map.SecurityDoor.CanCollide = not Map.SecurityDoorOpen
	Map.SecurityDoor.Transparency = Map.SecurityDoorOpen and 0.7 or 0
	VFXServer.Play("lock", Map.SecurityDoor, 0.6)
end)

-- DESKS
local function setDeskBought(slot, bought)
	local desk = Map.Desks[slot]
	if not desk then return end
	desk.bought = bought
	for _, d in ipairs(desk.furniture:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Transparency = bought and 0 or 1
			if d:IsA("Seat") then d.CanCollide = bought end
		end
		if d:IsA("ProximityPrompt") then d.Enabled = bought end
	end
	desk.seat.CanCollide = bought
end
ctx.setDeskBought = setDeskBought

local playerDesks = {}
local function deskOccupant(slot)
	for _, pl in ipairs(Players:GetPlayers()) do
		if playerDesks[pl] == slot then return pl end
	end
	return nil
end
ctx.deskOccupant = deskOccupant

for slot, desk in pairs(Map.Desks) do
	desk.prompt.Triggered:Connect(function(player)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			desk.seat:Sit(hum)
		end
	end)
	desk.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occ = desk.seat.Occupant
		if occ then
			local pl = Players:GetPlayerFromCharacter(occ.Parent)
			if pl then
				playerDesks[pl] = slot
				notify(pl, "You are serving Desk " .. slot .. ". Wait for a guest.", "info")
			end
		else
			for pl, s in pairs(playerDesks) do
				if s == slot then playerDesks[pl] = nil end
			end
		end
	end)
end

-- GUEST SPAWNING
local function pickFreeDesk()
	local order = { 1, 2, 3 }
	for _, slot in ipairs(order) do
		local desk = Map.Desks[slot]
		if desk and desk.bought then
			local busy = false
			for _, g in pairs(State.activeGuests) do
				if g.desk == slot then busy = true end
			end
			if not busy then return slot end
		end
	end
	return nil
end

local function firstFreeRoom()
	for _, num in ipairs(Config.RoomNumbers) do
		if Map.Rooms[num].state == "clean" and not Map.Rooms[num].occupant then
			return num
		end
	end
	return nil
end
ctx.firstFreeRoom = firstFreeRoom

local function anyCleanRooms()
	for _, num in ipairs(Config.RoomNumbers) do
		if Map.Rooms[num].state == "clean" and not Map.Rooms[num].occupant then return true end
	end
	return false
end
ctx.anyCleanRooms = anyCleanRooms

local function startKnocking(num)
	local d = Map.Doors[num]
	if not d or d.knock then return end
	local s = Instance.new("Sound")
	s.SoundId = "rbxasset://sounds/snap.mp3"
	s.Volume = 1.4
	s.Pitch = 0.55
	s.Parent = d.part
	d.knock = task.spawn(function()
		while d.part.Parent and Map.Rooms[num].state == "monsterRoom" do
			s:Play()
			task.wait(1.6)
		end
	end)
end

local function stopKnocking(num)
	local d = Map.Doors[num]
	if d and d.knock then
		task.cancel(d.knock)
		d.knock = nil
		local s = d.part:FindFirstChildOfClass("Sound")
		if s then s:Destroy() end
	end
end

local function guestLeave(guest, destination, via, stopAtEnd)
	State.activeGuests[guest.id] = nil
	Remotes.GuestUpdate:FireAllClients({ desk = guest.desk, id = guest.id, present = false })
	task.spawn(function()
		for _, wp in ipairs(via or {}) do
			if not guest.model.Parent then return end
			walkTo(guest.model, wp, 20)
		end
		if guest.model.Parent then walkTo(guest.model, destination, 25) end
		if not guest.model.Parent then return end
		if stopAtEnd then
			local hum = guest.model:FindFirstChildOfClass("Humanoid")
			if hum then hum.WalkSpeed = 0 end
		else
			guest.model:Destroy()
		end
	end)
end
ctx.guestLeave = guestLeave

local function spawnGuest()
	local slot = pickFreeDesk()
	if not slot then return false end
	local nightCfg = Config.Nights[State.night]
	local isMonster
	if State.forceNext == "human" or State.forceNext == "monster" then
		isMonster = State.forceNext == "monster"
		State.forceNext = nil
	elseif State.monstersLeft &gt; 0 and (State.humansLeft &lt;= 0 or math.random() &lt; State.monstersLeft / (State.monstersLeft + State.humansLeft)) then
		isMonster = true
	else
		isMonster = false
	end

	local tells = {}
	local cameraApp = "normal"
	if isMonster then
		State.monstersLeft = State.monstersLeft - 1
		local visible = {}
		for _, t in ipairs(Config.Tells) do
			if t.cat ~= "Camera" then table.insert(visible, t.id) end
		end
		local cameraOnly = nightCfg.cameraOnly and math.random() &lt; 0.3
		if cameraOnly then
			cameraApp = "absent"
			tells = { "NoCamera" }
		else
			local count = math.random(2, 4)
			local chosen = {}
			local cats = {}
			local pool = {}
			for _, id in ipairs(visible) do table.insert(pool, id) end
			if math.random() &lt; 0.25 then table.insert(pool, "DistortedCam") cameraApp = "distorted" end
			local guard = 0
			while #chosen &lt; count and guard &lt; 60 do
				guard = guard + 1
				local id = pool[math.random(#pool)]
				local already = false
				for _, c in ipairs(chosen) do if c == id then already = true end end
				if not already then
					local cat
					for _, t in ipairs(Config.Tells) do if t.id == id then cat = t.cat end end
					local catCount = 0
					for _, c in ipairs(cats) do if c == cat then catCount = catCount + 1 end end
					if catCount == 0 or #chosen &gt;= 2 then
						table.insert(chosen, id)
						if catCount == 0 then table.insert(cats, cat) end
					end
				end
			end
			-- ensure at least 2 categories
			if #cats &lt; 2 then
				for _, t in ipairs(Config.Tells) do
					local found = false
					for _, c in ipairs(cats) do if c == t.cat then found = true end end
					if not found and t.cat ~= "Camera" then
						table.insert(chosen, t.id)
						table.insert(cats, t.cat)
						break
					end
				end
			end
			tells = chosen
		end
	else
		State.humansLeft = State.humansLeft - 1
	end

	local idFrom = Config.Cities[math.random(#Config.Cities)]
	local guest = GuestGen.Create(ctx, {
		isMonster = isMonster,
		tells = tells,
		cameraApp = cameraApp,
		walkSpeed = 16,
		desk = slot,
		spawnPos = Vector3.new(math.random(-6, 6), 3.5, 56),
		idFrom = idFrom,
	})
	guest.model.Parent = map
	State.activeGuests[guest.id] = guest

	local bell = Map.Desks[slot].bell
	bell.Pitch = guest.angry and 1.6 or 1
	bell:Play()
	notify(nil, (guest.angry and "AN ANGRY GUEST" or "GUEST ARRIVED") .. " at Desk " .. slot, "guest")
	Remotes.GuestUpdate:FireAllClients({
		desk = slot, id = guest.id, present = true,
		name = guest.spokenName, angry = guest.angry,
		cameraApp = guest.cameraApp,
		extraQ = Config.ExtraQuestions[math.random(#Config.ExtraQuestions)].id,
	})

	task.spawn(function()
		walkTo(guest.model, Vector3.new(0, 3.5, 8), 20)
		walkTo(guest.model, Map.Desks[slot].pos, 20)
		GuestGen.Say(guest, "Evening. Name's " .. guest.spokenName .. ". I need a room.")
	end)
	return true
end
ctx.spawnGuest = spawnGuest

-- INSPECTION / QUESTIONS / DECISIONS
local function getGuest(guestId)
	return State.activeGuests[guestId]
end

local function visibleTellsIn(guest, cat)
	local labels = {}
	for _, id in ipairs(guest.tells) do
		for _, t in ipairs(Config.Tells) do
			if t.id == id and t.cat == cat then table.insert(labels, t.label) end
		end
	end
	return labels
end
ctx.visibleTellsIn = visibleTellsIn

Remotes.Inspect.OnServerEvent:Connect(function(player, guestId, category)
	local guest = getGuest(guestId)
	if not guest then return end
	if State.phase ~= "Night" then return end
	if playerDesks[player] ~= guest.desk then return end
	if category == "open" then
		Remotes.InspectResult:FireClient(player, guest.id, "open", {}, (guest.model:FindFirstChild("Head") or guest.model.PrimaryPart).CFrame)
	else
		local labels = visibleTellsIn(guest, category)
		Remotes.InspectResult:FireClient(player, guest.id, category, labels, nil)
	end
end)

Remotes.Ask.OnServerEvent:Connect(function(player, guestId, qid)
	local guest = getGuest(guestId)
	if not guest then return end
	if State.phase ~= "Night" then return end
	if playerDesks[player] ~= guest.desk then return end
	local text
	if qid == "from" then
		text = guest.answers.from
	elseif qid == "id" then
		text = "Sure. Here it is."
	elseif qid == "year" then
		text = guest.answers.year
	elseif qid == "job" then
		text = guest.answers.job
	elseif qid == "stay" then
		text = guest.answers.stay
	else
		return
	end
	GuestGen.Say(guest, text)
	Remotes.Answer:FireClient(player, guest.id, qid, text, guest.idCard)
end)

local function applyMoney(amount)
	if State.toggles.infiniteMoney then return end
	State.money = State.money + amount
	if amount &gt; 0 then State.earnedTonight = State.earnedTonight + amount end
end
ctx.applyMoney = applyMoney

local function applyRep(amount)
	State.rep = State.rep + amount
end
ctx.applyRep = applyRep

Remotes.Decide.OnServerEvent:Connect(function(player, guestId, admit)
	local guest = getGuest(guestId)
	if not guest then return end
	if State.phase ~= "Night" then return end
	if playerDesks[player] ~= guest.desk then return end

	if admit then
		if not anyCleanRooms() then
			notify(player, "No clean rooms! Clean rooms in the morning first.", "bad")
			return
		end
		local num = firstFreeRoom()
		if not num then
			notify(player, "No clean rooms!", "bad")
			return
		end
		if guest.isMonster then
			Map.Rooms[num].state = "monsterRoom"
			Map.Rooms[num].occupant = guest
			guest.roomNumber = num
			table.insert(State.admittedMonsters, guest)
			startKnocking(num)
			task.spawn(function()
				task.wait(0.4)
				for i = 1, 6 do
					Map.RoomLights[num].Transparency = 1
					local pl = Map.RoomLights[num]:FindFirstChildOfClass("PointLight")
					if pl then pl.Enabled = not pl.Enabled end
					task.wait(0.15)
				end
				Map.RoomLights[num].Transparency = 0
			end)
			VFXServer.Shake(1.2)
			VFXServer.Play("rumble", workspace, 0.8, 0.5)
			notify(nil, "Something feels wrong about Room " .. num .. "...", "bad")
			SanityServer.Drain(player, 15, "admitted a monster")
			log("Desk " .. guest.desk .. ": ADMITTED A MONSTER -&gt; Room " .. num)
		else
			Map.Rooms[num].state = "occupied"
			Map.Rooms[num].occupant = guest
			guest.roomNumber = num
			table.insert(State.admittedHumans, guest)
			applyMoney(Config.AdmitHumanMoney)
			applyRep(Config.AdmitHumanRep)
			State.correctCalls = State.correctCalls + 1
			VFXServer.Play("bell", workspace, 0.9, 1.4)
			notify(nil, "Correct call! +$" .. Config.AdmitHumanMoney, "good")
			log("Desk " .. guest.desk .. ": admitted human " .. guest.spokenName .. " -&gt; Room " .. num)
		end
		local roomX = (num - 101) * 10 - 25
		setDoor(num, true)
		guestLeave(guest, Vector3.new(roomX, 3.5, -38), { Vector3.new(0, 3.5, -18) }, true)
	else
		if guest.isMonster then
			applyMoney(Config.DenyMonsterMoney)
			applyRep(Config.DenyMonsterRep)
			State.correctCalls = State.correctCalls + 1
			State.monstersCaught = State.monstersCaught + 1
			VFXServer.Play("bell", workspace, 0.9, 1.4)
			notify(nil, "Correct call! Monster turned away. +$" .. Config.DenyMonsterMoney, "good")
			log("Desk " .. guest.desk .. ": turned away a MONSTER")
		else
			applyMoney(Config.DenyHumanMoney)
			applyRep(Config.DenyHumanRep)
			State.wrongCalls = State.wrongCalls + 1
			notify(nil, "You turned away a real human. -$10", "bad")
			SanityServer.Drain(player, 5, "turned away a human")
			log("Desk " .. guest.desk .. ": turned away human " .. guest.spokenName)
			if math.random() &lt; Config.AngryReturnChance and not guest.angry then
				task.spawn(function()
					task.wait(math.random(20, 45))
					if State.phase ~= "Night" then return end
					local slot2 = pickFreeDesk()
					if not slot2 then return end
					local angry = GuestGen.Create(ctx, {
						isMonster = false, tells = {}, cameraApp = "normal",
						walkSpeed = 20, desk = slot2, angry = true,
						spawnPos = Vector3.new(math.random(-6, 6), 3.5, 56),
						idFrom = guest.idCard.from,
					})
					angry.model.Parent = map
					State.activeGuests[angry.id] = angry
					Map.Desks[slot2].bell.Pitch = 1.6
					Map.Desks[slot2].bell:Play()
					notify(nil, "The guest you turned away is BACK, and he is angry.", "bad")
					Remotes.GuestUpdate:FireAllClients({ desk = slot2, id = angry.id, present = true, name = angry.spokenName .. " (angry)", cameraApp = "normal", extraQ = Config.ExtraQuestions[math.random(#Config.ExtraQuestions)].id })
					task.spawn(function()
						walkTo(angry.model, Vector3.new(0, 3.5, 8), 15)
						walkTo(angry.model, Map.Desks[slot2].pos, 15)
						GuestGen.Say(angry, "You turned ME away?! I demand a room. NOW.")
					end)
				end)
			end
		end
		guestLeave(guest, Vector3.new(math.random(-8, 8), 3.5, 58))
	end
	sendState()
end)

-- NIGHT FLOW
local function resetRooms()
	for _, num in ipairs(Config.RoomNumbers) do
		local r = Map.Rooms[num]
		if r.state ~= "messy" and r.state ~= "overstayer" then
			-- unfinished morning chores (messy/overstayer) stay blocked into the next night
			if r.occupant and r.occupant.model then r.occupant.model:Destroy() end
			r.occupant = nil
			r.state = "clean"
			stopKnocking(num)
			setDoor(num, true)
			setDoorLock(num, false)
			local d = Map.Doors[num]
			d.barricaded = false
			d.breaking = false
			d.part.CanCollide = true
			d.part.Transparency = 0
			d.chair.Anchored = true
			d.chair.CFrame = CFrame.new((num - 101) * 10 - 25 + 2, 0.9, -38)
			d.chair.Transparency = 0
		end
	end
end
ctx.resetRooms = resetRooms

local function servingDone()
	if State.queueLeft &gt; 0 then return false end
	for _ in pairs(State.activeGuests) do
		return false
	end
	return true
end

local function startNight(n)
	State.night = n
	State.phase = "Night"
	State.correctCalls = 0
	State.wrongCalls = 0
	State.monstersCaught = 0
	State.earnedTonight = 0
	State.admittedMonsters = {}
	State.admittedHumans = {}
	State.snapshotMoney = State.money
	State.snapshotRep = State.rep
	State.choresDone = false
	local cfg = Config.Nights[n]
	State.guestsPerNight = State.quotaGuests or cfg.guests
	State.monstersPerNight = State.quotaMonsters or cfg.monsters
	State.queueLeft = State.guestsPerNight
	State.humansLeft = State.guestsPerNight - State.monstersPerNight
	State.monstersLeft = State.monstersPerNight
	State.rulesRevealed = 3
	for i = 2, n do
		State.rulesRevealed = State.rulesRevealed + (Config.Nights[i].newRules or 0)
	end
	State.rulesRevealed = math.min(State.rulesRevealed, #Config.Rules)
	resetRooms()
	VFXServer.NightLight()
	VFXServer.SetRain(true, 1)
	VFXServer.SetFog(true)
	local bonus = State.rep
	if bonus ~= 0 then
		applyMoney(bonus)
		log("Night " .. n .. " starting bonus from reputation: $" .. bonus)
	end
	local newRules = {}
	for i = State.rulesRevealed - (cfg.newRules or 0) + 1, State.rulesRevealed do
		if i &gt;= 1 then table.insert(newRules, Config.Rules[i]) end
	end
	Remotes.TitleCard:FireAllClients(n, Config.Objectives[n], newRules, cfg.hints)
	sendState()
	log("Night " .. n .. " started: " .. State.guestsPerNight .. " guests, " .. State.monstersPerNight .. " monsters")

	task.spawn(function()
		task.wait(6)
		while State.phase == "Night" and State.queueLeft &gt; 0 do
			if not State.toggles.freeze and not State.toggles.paused then
				spawnGuest()
			end
			task.wait(Config.NextGuestDelay)
		end
		while State.phase == "Night" and not servingDone() do
			task.wait(1)
		end
		if State.phase ~= "Night" then return end
		if #State.admittedMonsters &gt; 0 then
			local survived = HuntManager.Run(ctx, State.admittedMonsters)
			if not survived then return end
		else
			notify(nil, "No monsters got in tonight. Quiet night...", "good")
		end
		VFXServer.DawnLight()
		ChoresServer.Process(ctx, State.admittedMonsters, State.admittedHumans)
		State.phase = "Dawn"
		sendState()
		Remotes.Dawn:FireAllClients({
			night = State.night,
			earned = State.earnedTonight,
			correct = State.correctCalls,
			wrong = State.wrongCalls,
			caught = State.monstersCaught,
			chores = ChoresServer.GetChoreList(),
			isFinalNight = State.night &gt;= 5,
		})
		log("Dawn after night " .. State.night)
	end)
end
ctx.startNight = startNight

Remotes.NextNight.OnServerEvent:Connect(function(player)
	if State.phase == "GameOver" then
		State.money = State.snapshotMoney
		State.rep = State.snapshotRep
		for _, pl in ipairs(Players:GetPlayers()) do
			local char = pl.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Anchored = false
				hrp.CFrame = CFrame.new(0, 4, 50)
			end
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then hum.WalkSpeed = 16 end
			Remotes.Downed:FireClient(pl, false)
		end
		startNight(State.night)
		return
	end
	if State.phase == "Win" then
		State.phase = "Lobby"
		State.night = 1
		State.money = Config.StartMoney
		State.rep = 0
		State.desksBought = 1
		setDeskBought(2, false)
		setDeskBought(3, false)
		State.rulesRevealed = 3
		startNight(1)
		return
	end
	if State.phase ~= "Dawn" and State.phase ~= "Shop" then return end
	if State.night &gt;= 5 then
		State.phase = "Win"
		sendState()
		Remotes.EndScreen:FireAllClients(true, { money = State.money, stars = stars() })
		log("WIN: survived all 5 nights")
		return
	end
	State.phase = "Shop"
	sendState()
	startNight(State.night + 1)
end)

Remotes.Shop.OnServerEvent:Connect(function(player, action, data)
	ShopServer.Handle(player, action, data)
end)

Remotes.ChoreReply.OnServerEvent:Connect(function(player, room, choice)
	ChoresServer.HandleReply(player, room, choice)
end)

Remotes.QuickChat.OnServerEvent:Connect(function(player, text)
	if type(text) ~= "string" or #text &gt; 60 then return end
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if head then
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.new(0, 220, 0, 50)
		bb.StudsOffset = Vector3.new(0, 2.2, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 50
		bb.Parent = head
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.new(1, 0, 1, 0)
		tl.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
		tl.BackgroundTransparency = 0.3
		tl.TextColor3 = Color3.fromRGB(255, 240, 160)
		tl.TextScaled = true
		tl.Font = Enum.Font.GothamBold
		tl.Text = text
		tl.Parent = bb
		Debris:AddItem(bb, 4)
	end
end)

Players.PlayerAdded:Connect(function(player)
	SanityServer.AddPlayer(player)
	sendState()
	if #Players:GetPlayers() == 1 and State.phase == "Lobby" then
		task.delay(5, function()
			if State.phase == "Lobby" then startNight(1) end
		end)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	SanityServer.RemovePlayer(player)
	playerDesks[player] = nil
end)

-- CONTROLS (used by the admin panel)
Controls.sendState = sendState
Controls.log = log
Controls.notify = notify
Controls.setDoor = setDoor
Controls.setDoorLock = setDoorLock
Controls.setDeskBought = setDeskBought
Controls.setKnocking = startKnocking
Controls.stopKnocking = stopKnocking
Controls.pickFreeDesk = pickFreeDesk
Controls.getGuest = getGuest
Controls.walkTo = walkTo
Controls.applyMoney = applyMoney
Controls.applyRep = applyRep
Controls.spawnGuest = spawnGuest
Controls.startNight = startNight
Controls.resetRooms = resetRooms
Controls.stars = stars
Controls.playerDesks = playerDesks

log("Night Shift Motel server loaded. Waiting for players...")
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source">-- MapBuilder v2: builds the entire motel from Parts at runtime. Detailed horror-motel look.
local MapBuilder = {}

local map

local function P(t)
	local p = Instance.new(t.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = t.Size or Vector3.new(4, 1, 2)
	p.CFrame = t.CF or CFrame.new(t.Pos or Vector3.new()) * CFrame.Angles((t.Rot and t.Rot[1]) or 0, (t.Rot and t.Rot[2]) or 0, (t.Rot and t.Rot[3]) or 0)
	p.Color = t.Color or Color3.fromRGB(120, 120, 120)
	p.Material = t.Material or Enum.Material.SmoothPlastic
	if t.Transparency then p.Transparency = t.Transparency end
	if t.Reflectance then p.Reflectance = t.Reflectance end
	if t.CanCollide ~= nil then p.CanCollide = t.CanCollide end
	if t.Shape then p.Shape = t.Shape end
	if t.Name then p.Name = t.Name end
	p.Parent = t.Parent or map
	return p
end

local function label(part, text, textColor, face, font, bg)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face or Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(600, 300)
	sg.Parent = part
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.new(1, 0, 1, 0)
	tl.BackgroundColor3 = bg or Color3.fromRGB(12, 10, 10)
	tl.BackgroundTransparency = bg and 0 or 1
	tl.Text = text
	tl.TextColor3 = textColor or Color3.fromRGB(255, 60, 60)
	tl.TextScaled = true
	tl.Font = font or Enum.Font.Arcade
	tl.Parent = sg
	return tl
end

local function light(part, brightness, range, color)
	local pl = Instance.new("PointLight")
	pl.Brightness = brightness or 1.2
	pl.Range = range or 18
	pl.Color = color or Color3.fromRGB(255, 225, 180)
	pl.Parent = part
	return pl
end

local function makePrompt(parent, text, hold, maxDist)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = text
	pr.ObjectText = ""
	pr.HoldDuration = hold or 0
	pr.MaxActivationDistance = maxDist or 10
	pr.RequiresLineOfSight = false
	pr.Parent = parent
	return pr
end

local function tree(x, z, s)
	s = s or 1
	P({ Pos = Vector3.new(x, 3 * s, z), Size = Vector3.new(1.6 * s, 6 * s, 1.6 * s), Color = Color3.fromRGB(66, 48, 36), Material = Enum.Material.Wood })
	P({ Pos = Vector3.new(x, 7 * s, z), Size = Vector3.new(6.5 * s, 3.6 * s, 6.5 * s), Color = Color3.fromRGB(28, 58, 38), Material = Enum.Material.Grass })
	P({ Pos = Vector3.new(x, 10.2 * s, z), Size = Vector3.new(4.8 * s, 3.2 * s, 4.8 * s), Color = Color3.fromRGB(24, 52, 34), Material = Enum.Material.Grass })
	P({ Pos = Vector3.new(x, 13 * s, z), Size = Vector3.new(3 * s, 2.8 * s, 3 * s), Color = Color3.fromRGB(20, 46, 30), Material = Enum.Material.Grass })
end

local function bush(x, z)
	P({ Pos = Vector3.new(x, 0.9, z), Size = Vector3.new(2.6, 1.8, 2.6), Shape = Enum.PartType.Ball, Color = Color3.fromRGB(30, 56, 36), Material = Enum.Material.Grass })
end

local function plantPot(x, z, parent)
	local pot = P({ Parent = parent, Pos = Vector3.new(x, 0.7, z), Size = Vector3.new(1.2, 1.4, 1.2), Shape = Enum.PartType.Cylinder, Rot = { 0, 0, 90 }, Color = Color3.fromRGB(140, 70, 50), Material = Enum.Material.Concrete })
	P({ Parent = parent, Pos = Vector3.new(x, 2.2, z), Size = Vector3.new(1.7, 1.9, 1.7), Shape = Enum.PartType.Ball, Color = Color3.fromRGB(40, 78, 48), Material = Enum.Material.Grass, CanCollide = false })
	return pot
end

local function car(x, z, rot, color)
	local folder = Instance.new("Folder")
	folder.Name = "Car"
	folder.Parent = map
	local cf = CFrame.new(x, 1.2, z) * CFrame.Angles(0, rot, 0)
	P({ Parent = folder, CF = cf, Size = Vector3.new(6.4, 1.3, 13), Color = color, Material = Enum.Material.Metal, Reflectance = 0.25 })
	P({ Parent = folder, CF = cf * CFrame.new(0, 1.15, -0.6), Size = Vector3.new(5.6, 1.3, 6.4), Color = Color3.fromRGB(24, 26, 30), Material = Enum.Material.Glass, Transparency = 0.35 })
	for _, wx in ipairs({ -2.6, 2.6 }) do
		for _, wz in ipairs({ -4.2, 4.2 }) do
			P({ Parent = folder, CF = cf * CFrame.new(wx, -0.55, wz) * CFrame.Angles(0, 0, math.rad(90)), Size = Vector3.new(1.1, 2.4, 1.1), Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(20, 20, 22), Material = Enum.Material.Rubber or Enum.Material.SmoothPlastic })
		end
	end
	P({ Parent = folder, CF = cf * CFrame.new(0, 0.1, 6.55), Size = Vector3.new(5.2, 0.5, 0.3), Color = Color3.fromRGB(255, 240, 190), Material = Enum.Material.Neon })
	P({ Parent = folder, CF = cf * CFrame.new(0, 0.1, -6.55), Size = Vector3.new(5.2, 0.5, 0.3), Color = Color3.fromRGB(255, 60, 50), Material = Enum.Material.Neon })
end

local Map = {}
Map.Desks = {}
Map.Doors = {}
Map.RoomLights = {}
Map.Rooms = {}
Map.Cameras = {}
Map.LobbyLights = {}
Map.SignNeons = {}

function MapBuilder.Build(ctx)
	map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace

	local asphalt = Color3.fromRGB(40, 40, 44)
	local grass = Color3.fromRGB(34, 48, 32)
	local brick = Color3.fromRGB(94, 62, 54)
	local trim = Color3.fromRGB(196, 176, 138)
	local wood = Color3.fromRGB(104, 74, 50)
	local woodDark = Color3.fromRGB(72, 50, 34)
	local wallWood = Color3.fromRGB(116, 86, 58)
	local carpet = Color3.fromRGB(88, 32, 32)
	local roomFloor = Color3.fromRGB(122, 88, 58)

	-- ============ GROUND / LOT / ROAD ============
	P({ Pos = Vector3.new(0, -0.5, 5), Size = Vector3.new(260, 1, 220), Color = grass, Material = Enum.Material.Grass, Name = "Ground" })
	P({ Pos = Vector3.new(0, -0.44, 20), Size = Vector3.new(180, 0.12, 120), Color = asphalt, Material = Enum.Material.Asphalt, Reflectance = 0.14, Name = "Lot" })
	P({ Pos = Vector3.new(0, -0.4, 92), Size = Vector3.new(260, 0.2, 26), Color = Color3.fromRGB(30, 30, 33), Material = Enum.Material.Asphalt, Name = "Road" })
	for i = -6, 6 do
		P({ Pos = Vector3.new(i * 18, -0.28, 92), Size = Vector3.new(7, 0.06, 0.9), Color = Color3.fromRGB(215, 195, 80), CanCollide = false })
	end
	for i = -2, 2 do
		P({ Pos = Vector3.new(i * 7 - 14, -0.28, 80.5), Size = Vector3.new(0.9, 0.06, 22), Color = Color3.fromRGB(230, 230, 225), CanCollide = false, Transparency = 0.3 })
	end
	-- curbs + parking lines
	for i = -3, 3 do
		P({ Pos = Vector3.new(i * 14, 0.15, 36), Size = Vector3.new(0.6, 0.3, 24), Color = Color3.fromRGB(180, 178, 170), Material = Enum.Material.Concrete })
		P({ Pos = Vector3.new(i * 14 - 7, 0.06, 42), Size = Vector3.new(0.5, 0.06, 20), Color = Color3.fromRGB(225, 225, 220), CanCollide = false })
		P({ Pos = Vector3.new(i * 14 + 7, 0.06, 42), Size = Vector3.new(0.5, 0.06, 20), Color = Color3.fromRGB(225, 225, 220), CanCollide = false })
	end
	P({ Pos = Vector3.new(0, 0.04, 24), Size = Vector3.new(120, 0.08, 8), Color = Color3.fromRGB(150, 148, 142), Material = Enum.Material.Concrete, Name = "Sidewalk" })
	P({ Pos = Vector3.new(0, 0.04, 30), Size = Vector3.new(10, 0.08, 16), Color = Color3.fromRGB(150, 148, 142), Material = Enum.Material.Concrete, Name = "Walkway" })

	car(-21, 44, math.rad(90), Color3.fromRGB(96, 34, 38))
	car(35, 46, math.rad(90), Color3.fromRGB(52, 66, 88))
	car(7, 46, math.rad(90), Color3.fromRGB(70, 70, 74))

	-- dumpster + crates + power box + bench
	P({ Pos = Vector3.new(-42, 1.6, 30), Size = Vector3.new(6, 3.2, 3.4), Color = Color3.fromRGB(40, 62, 44), Material = Enum.Material.DiamondPlate, Name = "Dumpster" })
	P({ Pos = Vector3.new(-42, 3.4, 30), Size = Vector3.new(6.4, 0.4, 3.8), Color = Color3.fromRGB(34, 52, 38), Material = Enum.Material.Metal, Rot = { math.rad(-8), 0, 0 } })
	P({ Pos = Vector3.new(44, 1, 28), Size = Vector3.new(3, 2, 3), Color = Color3.fromRGB(96, 72, 48), Material = Enum.Material.WoodPlanks })
	P({ Pos = Vector3.new(44, 2.9, 28), Size = Vector3.new(2.6, 1.8, 2.6), Color = Color3.fromRGB(88, 66, 44), Material = Enum.Material.WoodPlanks, Rot = { 0, math.rad(20), 0 } })
	P({ Pos = Vector3.new(44, 1.5, 24), Size = Vector3.new(2.4, 3, 1.2), Color = Color3.fromRGB(70, 74, 78), Material = Enum.Material.Metal, Name = "PowerBox" })
	label(P({ Pos = Vector3.new(44, 1.5, 24.65), Size = Vector3.new(1.8, 1.2, 0.05), Color = Color3.fromRGB(200, 170, 60), CanCollide = false }), "!", Color3.fromRGB(40, 30, 10))
	P({ Pos = Vector3.new(14, 1.1, 26.5), Size = Vector3.new(6, 0.4, 2.2), Color = Color3.fromRGB(96, 66, 44), Material = Enum.Material.Wood })
	P({ Pos = Vector3.new(14, 0.55, 26.5), Size = Vector3.new(6, 0.9, 0.4), Color = Color3.fromRGB(96, 66, 44), Material = Enum.Material.Wood })

	-- ============ BUILDING SHELL (x -34..34, z -48..20) ============
	-- slab
	P({ Pos = Vector3.new(0, 0.06, -14), Size = Vector3.new(70, 0.12, 70), Color = Color3.fromRGB(60, 60, 62), Material = Enum.Material.Concrete })
	-- lobby floor: checkered
	for ix = 0, 15 do
		for iz = 0, 9 do
			local dark = (ix + iz) % 2 == 0
			P({
				Pos = Vector3.new(-30 + ix * 4, 0.14, -18 + iz * 4),
				Size = Vector3.new(4, 0.08, 4),
				Color = dark and Color3.fromRGB(22, 22, 25) or Color3.fromRGB(214, 210, 200),
				Material = Enum.Material.Marble,
				CanCollide = false,
			})
		end
	end
	-- corridor carpet
	P({ Pos = Vector3.new(0, 0.16, -26), Size = Vector3.new(64, 0.08, 12), Color = carpet, Material = Enum.Material.Fabric, CanCollide = false, Name = "CorridorCarpet" })

	-- FRONT WALL z=20 (door gap x -5..5, windows)
	P({ Pos = Vector3.new(-19.75, 7, 20.5), Size = Vector3.new(30.5, 14, 1), Color = brick, Material = Enum.Material.Brick })
	P({ Pos = Vector3.new(19.75, 7, 20.5), Size = Vector3.new(30.5, 14, 1), Color = brick, Material = Enum.Material.Brick })
	P({ Pos = Vector3.new(0, 11.5, 20.5), Size = Vector3.new(10, 5, 1), Color = brick, Material = Enum.Material.Brick })
	-- windows with frames
	for _, wx in ipairs({ -19.75, 19.75 }) do
		P({ Pos = Vector3.new(wx, 6, 20.35), Size = Vector3.new(24, 8, 0.3), Color = trim, Material = Enum.Material.Wood })
		P({ Pos = Vector3.new(wx, 6, 20.2), Size = Vector3.new(22.5, 6.5, 0.3), Color = Color3.fromRGB(120, 150, 170), Material = Enum.Material.Glass, Transparency = 0.55, CanCollide = false })
		P({ Pos = Vector3.new(wx, 6, 20.05), Size = Vector3.new(0.4, 6.5, 0.35), Color = trim, Material = Enum.Material.Wood, CanCollide = false })
		P({ Pos = Vector3.new(wx, 2.2, 20.35), Size = Vector3.new(24, 1, 0.5), Color = trim, Material = Enum.Material.Wood })
	end
	-- awning over entrance
	P({ Pos = Vector3.new(0, 9.6, 23.5), Size = Vector3.new(16, 0.5, 7), Color = Color3.fromRGB(110, 34, 34), Material = Enum.Material.Fabric, Rot = { math.rad(8), 0, 0 } })
	P({ Pos = Vector3.new(0, 10.2, 20.8), Size = Vector3.new(16, 1.2, 0.8), Color = trim, Material = Enum.Material.Wood })
	for _, px in ipairs({ -7, 7 }) do
		P({ Pos = Vector3.new(px, 4.8, 26.6), Size = Vector3.new(0.4, 9.6, 0.4), Color = Color3.fromRGB(40, 40, 44), Material = Enum.Material.Metal })
	end
	label(P({ Pos = Vector3.new(0, 10.2, 21.25), Size = Vector3.new(10, 1, 0.1), Color = Color3.fromRGB(24, 20, 18), CanCollide = false }), "OFFICE  -&gt;", Color3.fromRGB(255, 200, 90))
	-- door mats
	P({ Pos = Vector3.new(0, 0.2, 22.5), Size = Vector3.new(8, 0.08, 4), Color = Color3.fromRGB(70, 40, 34), Material = Enum.Material.Fabric, CanCollide = false })

	-- SIDE WALLS
	P({ Pos = Vector3.new(-34.5, 7, -14), Size = Vector3.new(1, 14, 70), Color = brick, Material = Enum.Material.Brick })
	P({ Pos = Vector3.new(34.5, 7, -14), Size = Vector3.new(1, 14, 70), Color = brick, Material = Enum.Material.Brick })
	-- interior wall panels (lobby)
	P({ Pos = Vector3.new(-33.9, 6, -1), Size = Vector3.new(0.4, 12, 40), Color = wallWood, Material = Enum.Material.WoodPlanks, CanCollide = false })
	P({ Pos = Vector3.new(33.9, 6, -1), Size = Vector3.new(0.4, 12, 40), Color = wallWood, Material = Enum.Material.WoodPlanks, CanCollide = false })
	-- wainscot
	P({ Pos = Vector3.new(-33.7, 1.5, -1), Size = Vector3.new(0.3, 3, 40), Color = woodDark, Material = Enum.Material.Wood, CanCollide = false })
	P({ Pos = Vector3.new(33.7, 1.5, -1), Size = Vector3.new(0.3, 3, 40), Color = woodDark, Material = Enum.Material.Wood, CanCollide = false })

	-- BACK WALL z=-20 (corridor gap x -4..4)
	P({ Pos = Vector3.new(-19.75, 7, -20.5), Size = Vector3.new(30.5, 14, 1), Color = brick, Material = Enum.Material.Brick })
	P({ Pos = Vector3.new(19.75, 7, -20.5), Size = Vector3.new(30.5, 14, 1), Color = brick, Material = Enum.Material.Brick })
	P({ Pos = Vector3.new(0, 11.5, -20.5), Size = Vector3.new(10, 5, 1), Color = brick, Material = Enum.Material.Brick })
	P({ Pos = Vector3.new(0, 2.5, -20.2), Size = Vector3.new(10, 5, 0.3), Color = woodDark, Material = Enum.Material.Wood, CanCollide = false })

	-- CORRIDOR WALLS (z=-32 with 6 door gaps, 5 wide)
	P({ Pos = Vector3.new(-29.75, 5, -32.5), Size = Vector3.new(1.5, 10, 1), Color = wallWood, Material = Enum.Material.WoodPlanks })
	for i = 0, 5 do
		local cx = -25 + i * 10
		P({ Pos = Vector3.new(cx, 5, -32.5), Size = Vector3.new(1, 10, 1), Color = wallWood, Material = Enum.Material.WoodPlanks })
		label(P({ Pos = Vector3.new(cx, 8, -32.2), Size = Vector3.new(2.4, 1, 0.1), Color = woodDark, CanCollide = false }), tostring(101 + i), Color3.fromRGB(240, 225, 180))
	end
	P({ Pos = Vector3.new(-32, 5, -26), Size = Vector3.new(1, 10, 14), Color = wallWood, Material = Enum.Material.WoodPlanks })
	P({ Pos = Vector3.new(32, 5, -26), Size = Vector3.new(1, 10, 14), Color = wallWood, Material = Enum.Material.WoodPlanks })
	P({ Pos = Vector3.new(0, 10.2, -26), Size = Vector3.new(64, 0.4, 12), Color = Color3.fromRGB(56, 40, 30) })
